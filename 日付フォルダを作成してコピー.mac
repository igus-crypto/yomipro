s2 =%Q|saveas "#{f2}";\n;|
s2+=%Q|message "対象ファイルを#{f1}に設定しました","対象ファイル名",0,1000;|
File.write(m+"/"+f,s1) unless f==""
File.write("tmp.mac",s2)

__END__
