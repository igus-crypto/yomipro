//日付フォルダを作成してコピー

runsync2 "rubyw -x "+currentmacrofilename+" "+filename;
execmacro directory + "\\tmp.mac";
endmacro;

/*
#/
#! ruby
# encoding: utf-8
Encoding.default_external = 'UTF-8'

$stderr=open("tmp_err.txt","w")
$stdout=open("tmp99.txt","w")

t=Time.new
m=t.strftime("%y%m%d")
p m
f,s1,s2="","","";
