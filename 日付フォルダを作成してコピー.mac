Dir.glob("*.txt"){|e|
  if /^[^0-9a-zA-Z]/=~e
    f=e
    break
  end}
s1=open(f).read unless f==""
#f1=filename.encode(Encoding::UTF_8).gsub("\\","/")
f0=ARGV[0].encode(Encoding::UTF_8).gsub("\\","/")
f1=File.dirname(f0)+"/#{m}/"+File.basename(f0)
f2=f1.gsub("/","\\\\\\")
