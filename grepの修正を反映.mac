//grepの修正を反映

#x=x;#y=y;selectall;copy;escape;moveto #x,#y; 
runsync2 "rubyw -x "+currentmacrofilename+" \""+filename+"\"";
execmacro directory + "\\tmp0.mac";
endmacro;

