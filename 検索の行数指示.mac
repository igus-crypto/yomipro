//検索の行数指示


if(imestate==1)imeswitch;

#ctl=0;
if(iskeydown(0x11)){#ctl=1;}
if(#ctl==1){
  $n=input("行数入力（行数+50）","100");
}else{
  $n=input("行数入力","100");
}
// movetolineno 1,val($n);
runsync2 "rubyw -x "+currentmacrofilename+" "+$n+" "+str(#ctl);
execmacro directory + "\\tmp.mac";
endmacro;

