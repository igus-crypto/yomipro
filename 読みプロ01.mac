    setactivehidemaru 1,-1;#i=#i+1;}
  while(#n<#c){
    if(leftstr(basename,3)!="tmp"){break;}
    setactivehidemaru 1,-1;#n=#n+1;}
  while(#k<#j){closehidemaruforced findhidemaru($files[#k]);#k=#k+1;}
  question "tmpファイルを削除しますか？";
  if(result==yes){runsync2 "rubyw "+currentmacrodirectory+"\\del_tmp.rbw";}
}else if(#s==312){ //grep結果の編集を置換
  selectall;copy;
  //runsync2 "rubyw "+currentmacrodirectory+"\\replace4.rbw "+ filename ; //標準速度
  runsync2 "rubyw "+currentmacrodirectory+"\\replace4.rbw "+ filename +" k"; //高速
  execmacro directory + "\\tmp.mac";
}else if(#s==313){ //フォルダ名のファイル準備
  execmacro currentmacrodirectory + "\\フォルダ名のファイル準備.mac";
}else if(#s==314){ //ファイル結合
  execmacro currentmacrodirectory + "\\ファイル結合.mac";
}else if(#s==315){ //対象ファイル編集
  runsync2 "rubyw "+currentmacrodirectory+"\\moon.rbw e";
  execmacro directory + "\\tmp.mac";
}else if(#s==316){ //更新日時を操作
  execmacro currentmacrodirectory + "\\更新日時を操作.mac";
}else if(#s==317){ //マッチの位置揃え変更
  run $uwsc+" "+currentmacrodirectory+"\\マッチの位置揃え変更.uws";
}else if(#s==318){ //マクロ編集
  $fl=currentmacrodirectory+"\\読みプロ01.mac";
  if(findhidemaru($fl)==-1){openfile $fl;}
  setactivehidemaru findhidemaru($fl);
}else if(#s==321){ //秀丸マクロメニュー
  run $uwsc+" "+currentmacrodirectory+"\\秀丸マクロメニュー.uws";
  //run $uwsc+" "+currentmacrodirectory+"\\キーバインド.uws";
}else if(#s==322){ //クリップボードにファイル名
  setclipboard filename;
}else if(#s==323){ //クリップボードにフォルダ名
  setclipboard directory;
}else if(#s==324){ //cmd
  run "cmd.exe /k chcp 65001";
}else if(#s==325){ //google検索
  if(selecting){
    $sel=gettext(seltopx,seltopy,selendx,selendy,1);
    run "cmd /c start chrome --incognito http://www.google.co.jp/search?q="+$sel+">nul";}
}else if(#s==327){ //検索マーカー
  $s=gettext(seltopx,seltopy,selendx,selendy, 1);
  setsearch $s , 0x34003800;
  colormarkerallfound;escape;
}else if(#s==328){ //分割マーカー
  colormarker 0x000000, 0xc2c79e, 11, 1;
  escape;
}else if(#s==329){ //拗音をマーク
  setsearch "(?<=[ぁ-んァ-ヴ])[ゃャ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[ゅュ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[ょョ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[っッ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[ぁぃぅぇぉァィゥェォ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[やゆよつヤユヨツ]" , 0x4003819;colormarkerallfound;
  setsearch "(?<=[ぁ-んァ-ヴ])[あいうえおアイウエオ]" , 0x4003819;colormarkerallfound;
}else if(#s==330){ //括弧をマーク
  execmacro currentmacrodirectory + "\\括弧をマーク.mac";
}else if(#s==332){ //自動送り
  execmacro currentmacrodirectory+"\\自動送り.mac";
}else if(#s==333){ //棒読み文庫
  execmacro currentmacrodirectory+"\\棒読み文庫.mac";
}else if(#s==334){ //割合表示
  execmacro currentmacrodirectory+"\\割合表示.mac";
}else if(#s==335){ //文字数カウント
  if(selecting){copy2;}else{#x=x;#y=y;selectall;copy;moveto #x,#y;}
  runsync2 "rubyw "+currentmacrodirectory+"\\moji_count.rbw";
}else if(#s==336){ //タグジャンプサーチ
  if(selecting){copy2;}else{beginsel;right;copy2;left;}
  tagjump;beginclipboardread;$c=getclipboard;searchdown $c ,hilight;
  right;left;
}else if(#s==337){ //選択部を次行の末尾にコピー
  copy;down;golineend;paste;
}else if(#s==338){ //挿入して戻る
  #x=x;#y=y;paste;moveto #x,#y;
}else if(#s==339){ //選択文字で上候補
  if(selecting){
    $seltext = gettext(seltopx,seltopy,selendx,selendy);
    searchup $seltext ,hilight;findup;}
  else{findup;}
}else if(#s==340){ //選択文字で下候補
  if(selecting){
    $seltext = gettext(seltopx,seltopy,selendx,selendy);
    searchdown $seltext ,hilight;finddown;}
  else{finddown;}
}else if(#s==341){ //選択文字で次の秀丸を検索
  if(selecting){
    $seltext = gettext(seltopx,seltopy,selendx,selendy);
    setactivehidemaru 1;setsearch $seltext ,0x35003800;finddown;
    colormarkerallfound;escape;}
  else{endmacro;}
}else if(#s==342){ //選択文字で対象ファイルを検索
  if(selecting){
    copy;
    runsync2 "rubyw "+currentmacrodirectory+"\\moon.rbw g";
    execmacro directory + "\\tmp.mac";}
  else{endmacro;}
}else if(#s==343){ //ファイルを開いて選択文字検索
  execmacro currentmacrodirectory+"\\ファイルを開いて選択文字検索.mac";
}else if(#s==344){ //差分チェック
  #hwnd_f0 = hidemaruhandle(0);
  //message "ファイルを選択してください", "ファイル選択", 0x03;
  readonlyopenfile "/h /r .\\*.txt";
  #hwnd_f1 = hidemaruhandle(0);
  $f1=filename;
  if ($f1==""){
    setactivehidemaru 1;
    closehidemaruforced #hwnd_f1;
    endmacro;}
  //message "比較するファイルを選択してください", "ファイル選択", 0x03;
  readonlyopenfile "/h /r .\\*.txt";
  #hwnd_f2 = hidemaruhandle(0);
  $f2=filename;
  if ($f2==""){
    setactivehidemaru 1;
    closehidemaruforced #hwnd_f2;
    endmacro;}
  setactivehidemaru #hwnd_f0;
  closehidemaruforced #hwnd_f1;
  closehidemaruforced #hwnd_f2;
  //message 
  runsync2 "rubyw "+currentmacrodirectory+"\\diff7.rbw "+$f1+" "+$f2;
}else if(#s==345){ //読みプロ01のNoチェックNoチェック
  #x=x;#y=y;selectall;copy;moveto #x,#y;down;
  runsync2 "rubyw "+currentmacrodirectory+"\\moon.rbw m";
}else if(#s==346){ //青空変換（２）
  execmacro currentmacrodirectory + "\\青空変換（２）.mac";
}else if(#s==347){ //青空変換（改）
  execmacro currentmacrodirectory + "\\青空変換（改）.mac";
}else if(#s==349){ //縦に並べて表示
  #hwnd_f1= hidemaruhandle(0);setactivehidemaru 1;#hwnd_f2= hidemaruhandle(0);
  iconall;setactivehidemaru #hwnd_f1;setactivehidemaru #hwnd_f2;windowvert;
  setwindowsize 100, 14;setwindowpos 80, 0;
  setactivehidemaru #hwnd_f1;setwindowsize 100, 14;setwindowpos 80, 360;
}else if(#s==350){ //横に並べて表示
  #hwnd_f1= hidemaruhandle(0);setactivehidemaru 1;#hwnd_f2= hidemaruhandle(0);
  iconall;setactivehidemaru #hwnd_f1;setactivehidemaru #hwnd_f2;windowhorz;
  setwindowsize 48, 34;setwindowpos 80, 0;
  setactivehidemaru #hwnd_f1;setwindowsize 48, 34;setwindowpos 600, 0;
}else if(#s==351){ //ウィンドウ分割
  split;
}else if(#s==352){ //ウィンドウサイズ
  setwindowsize 100, 30;
}else if(#s==353){ //ウィンドウサイズ
  setwindowsize 60, 20;
}else if(#s==354){ //すべて最小化
  iconall;
}else if(#s==355){ //すべて 100×30
  $file=filename;setwindowsize 100, 30;nexthidemaru;#i=1;
  while(filename!=$file){//message str(80+50*#i);
    setwindowsize 100, 30;
    setwindowpos 40+25*#i, -20+25*#i;nexthidemaru;#i=#i+1;}
  setwindowpos 40+25*#i, -20+25*#i;
}

endmacro;

