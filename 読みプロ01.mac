$dir=directory;
$ini=currentmacrodirectory + "\\config.ini";
$uwsc=getinistrw($ini,"path","uwsc");
$fl01=getinistrw($ini,"grep","file_1");

#x=x;#y=y;

if(#s==2){ //青空ルビー
  execmacro currentmacrodirectory+"\\青空ルビー.mac";
}else if(#s==3){ //青空文庫保存
  execmacro currentmacrodirectory+"\\青空文庫保存.mac";
}else if(#s==4){ //UTF8保存
  runsync2 "rubyw "+currentmacrodirectory+"\\send.rbw u "+filename;
  execmacro directory + "\\tmp.mac";
}else if(#s==5){ //字下げの処理
  execmacro currentmacrodirectory+"\\字下げの処理.mac";
}else if(#s==6){ //青空文庫外字変換
  execmacro currentmacrodirectory+"\\青空文庫外字変換.mac";
  //selectall;copy;
  //runsync2 "rubyw "+currentmacrodirectory+"\\grep8.rbw "+filename;
