//数字展開.mac

disabledraw;begingroupundo;
if(!selecting)selectline 1;
$s=getselectedtext();delete;
openfile "/h";insert $s;
saveas directory+"\\tmp1.txt";
#h=hidemaruhandle(0);
setactivehidemaru 1;
closehidemaruforced #h;
runsync2 "rubyw -x "+currentmacrofilename;
insertfile "tmp2.txt";
enabledraw;endgroupundo;endmacro;

