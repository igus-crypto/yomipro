//ボックス貼り付け

#x0=x;
begingroupundo;disabledraw;selectline 1;
#x=selendx;#y=selendy;copy;moveto #x,#y;
if(#x!=0)insert "\n";
runsync2 "rubyw -x "+currentmacrofilename+" "+str(#x0);
paste;
enabledraw;endgroupundo;endmacro;

