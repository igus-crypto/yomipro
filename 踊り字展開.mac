$stderr=open("tmp_errm.txt","w")

require_relative 'clipboard_compat'
cbd = ClipBoard.new(__ENCODING__)
ar=cbd.getText.lines

def expand_odori(s)
  if %r|《([^《》]+)／″?＼》|=~s
    s.gsub(%r|《([^《》]+)／″?＼》|){"《#{$1}#{$1}》"}
  else
    s.gsub(/(.+?)((?:／″?＼)+)/){
      s1=$1
      n=$2.scan(/／″?＼/).size
      s1*(n+1)
    }
  end
end

ar=ar.map{|s|
  s1=s.split(",",2)
  print "s1=";p s1
  if s1.size==2
    s2=s1[0]+","+expand_odori(s1[1])
  else
    s2=expand_odori(s1[0])
  end
  s2.gsub("、,s",",s")
}

cbd.setText(ar.join)

__END__
