//サーチ

//選択時
//標準           :全角入力
//shift          :半角入力
//alt             :次の秀丸を検索（ファイル移動）
//alt+shift       :次の秀丸を検索（ファイル保持）
//ctrl            :下検索
//ctrl+shift      :次の秀丸を検索（現在行固定）
//ctrl+shift+alt  :次の秀丸を検索（ファイル保持、語句検索）
//選択なし
//標準            :下検索
//ctrl            :上検索
//shift           :半角入力
//ctrl+alt+shift  :上検索

setcompatiblemode 0x00020200;

#fs=0;#fc=0;#fa=0;
if(iskeydown(0x10))#fs=1;
if(iskeydown(0x11))#fc=1;
if(iskeydown(0x12))#fa=1;

if(selecting){
  #tx=seltopx;#ty=seltopy;#ex=selendx;#ey=selendy;
  #tc=xtocolumn(#tx,#ty);#tl=ytolineno(#tx,#ty);
  #hwnd=hidemaruhandle(0);
  $sel = gettext(seltopx,seltopy,selendx,selendy);
  moveto #tx,#ty;beginsel; moveto #ex,#ey;
  if(#fc && #fs && #fa){
    setactivehidemaru 1;disabledraw;
    $sel=")"+$sel;
    setsearch $sel , 0x4003819;
    golineend2;
    searchdown $sel ,hilight,loop;
    copy2;escape;down 6;up 6;
    enabledraw y-4;
    setactivehidemaru 1;
    moveto #tx,#ty;beginsel;moveto #ex,#ey;
    endmacro;
//    setactivehidemaru 1,-1;
//    #i=0;#j=0;
//    while(1){
//      if(filename[#i]=="")break;
//      $fs[#i]=filename[#i];
//      #i = #i+1;}
//    while(#j<=#i){
//      setactivehidemaru(findhidemaru(filename[#j]));
//      searchdown $sel ,nohilight,loop;
//      if(result)break;
//      #j = #j+1;}
  }else if(#fc && #fs){
    #i=1;#j=1;
    while(#i<3){
      setactivehidemaru 1,-1;
      if(#hwnd==hidemaruhandle(0)){#i=#i+1;#j=1;}else{#j=0;}
      #x=x;#y=y;
      moveto2 0,#tl;
      #l=lineno-#tl;
      //message str(#l);
      if(#l<0){moveto #x,#y;continue;}
      escape;selectline 1;
      searchdown $sel ,nohilight,inselect2;
      #res=result;
      #ftx=foundtopx;#fty=foundtopy;#fex=foundendx;#fey=foundendy;
      //message "res="+str(#res)+"\ni="+str(#i)+"\nj="+str(#j)+"\nl="+str(#l);
      if(#res==1){
        if(#j==0){
          #res=result;
          moveto #ftx,#fty;beginsel;moveto #fex,#fey;
          setactivehidemaru #hwnd;setactivehidemaru 1;endmacro;
        }else if(#j==1){
          escape;moveto #tx,#ty;beginsel;moveto #ex,#ey;
        }
      }
      if((#i==2) && (#j==0) && (#l>=0)){
        setactivehidemaru #hwnd;setactivehidemaru 1;escape;moveto2 0,#tl;endmacro;}
    }
  }else if(#fc){
    searchdown $sel ,hilight,loop;
  }else if(#fa && #fs){
    setactivehidemaru 1;
    disabledraw;
    setsearch $sel , 0x4003819;
    searchdown $sel ,hilight,loop;
    copy2;escape;down 6;up 6;
    enabledraw;
    setactivehidemaru 1;
    moveto #tx,#ty;beginsel;moveto #ex,#ey;
    endmacro;
  }else if(#fa){
    setactivehidemaru 1;
    #x=x;#y=y;
    escape;moveto2 0,#tl;
    setsearch $sel , 0x4003819;
    searchdown $sel ,hilight,loop;
    if(result){
      #px=foundtopx;#py=foundtopy;#dx=foundendx;#dy=foundendy;
      escape;down 6;up 6;
      moveto #px,#py;beginsel;moveto #dx,#dy;
    }else{
      moveto #x,#y;
    }
    endmacro;
  }
}else{
//  if(#fc && #fs && #fa){
//    beginclipboardread;$txt = getclipboard();
//    searchup $txt ,hilight,loop;endmacro;
//  }else if(#fc && #fs){
//    beginclipboardread;$txt = getclipboard();
//    searchdown $txt ,hilight,loop;endmacro;}
//  if(!imestate)imeswitch; //imeオン
//  if(#fs)imeswitch;
//  $txt=input("");
//  if($txt=="")endmacro;
//  if(#fc){searchup $txt ,hilight,loop;}
//  else{searchdown $txt ,hilight,loop;}
  #c=column;#l=lineno;disabledraw;
  golineend2;searchup " =>";#r=result;
  if(#r && #l==lineno){right;beginsel; golineend2;}
  else{moveto2 #c,#l;}
  enabledraw;endmacro;
}
#tx=foundtopx;#ty=foundtopy;#ex=foundendx;#ey=foundendy;
escape;moveto #tx,#ty;beginsel;moveto #ex,#ey;

