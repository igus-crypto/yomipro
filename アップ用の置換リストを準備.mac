ar04=["([一二三四五六七八九〇]{2,})(?![一-龯々〇]*《)",
    "一二三四五六七八九〇","1234567890"]
ar11=["｜","《.*?》"]
ar12=[
  ["《[+%~!]","《"],
  ["《[=#][^《》]+》",""],
  ["《は","《ハ"],
  ["｜[^《》]+《([^《》]+)》",'\1'],
  ["[一-龯々〇]+《([^《》]+)》",'\1'],
  [".《([^《》]+)》",'\1']]
ar13=[ #置換後処理（読み上げ用）（単純置換）
