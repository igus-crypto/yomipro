list=s9.split(%r|\R|)
list.each{|line|
  next unless line
  line=line.chomp
  next if %r|^#|=~line
  #line=line.gsub(%r|《([ぁ-んァ-ヴー])|,'《%\1')
  a,b,c=line.split(%r|[,]|)
  next unless b
  a2=a[/\A\(\?<[!=][^)]+\)/] || ""
  a3=a[/\(\?[!=][^)]+\)\z/] || ""
  a1=a.gsub(a2,"").gsub(a3,"")
  #a4=b+"|"+a2+"|"+a3
  if c.nil?
    if %r|》$|=~b
      hashes[["n01b","",""]] ||= {}
      hashes[["n01b","",""]][a]=b
    else
      hashes[["n01a","",""]] ||= {}
      hashes[["n01a","",""]][a]=b
    end
  elsif %r|p[0-9]*1$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
    elsif %r|》$|=~b
      hashes[[c+"b",a2,a3]] ||= {}
      hashes[[c+"b",a2,a3]][a1]=b
    else
      hashes[[c+"c",a2,a3]] ||= {}
      hashes[[c+"c",a2,a3]][a1]=b
    end
  elsif %r|p[0-9]*2$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
    else
      hashes[[c+"b",a2,a3]] ||= {}
      hashes[[c+"b",a2,a3]][a1]=b
    end
  elsif %r|p[0-9]*3$|=~c
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
  elsif %r|p[0-9]*4$|=~c
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
  elsif %r|p[0-9]*5$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
    else
      hashes[[c+"b",a2,a3]] ||= {}
      hashes[[c+"b",a2,a3]][a1]=b
    end
  elsif %r|p[0-9]*6$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
    else
      hashes[[c+"b",a2,a3]] ||= {}
      hashes[[c+"b",a2,a3]][a1]=b
    end
  elsif %r|p[0-9]*7$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
    else
      hashes[[c+"b",a2,a3]] ||= {}
      hashes[[c+"b",a2,a3]][a1]=b
    end
  elsif %r|p[0-9]*8$|=~c
    if %r|》$|=~b && %r|[一-龯々〇｜]$|=~a1
      hashes[[c+"a",a2,a3]] ||= {}
      hashes[[c+"a",a2,a3]][a1]=b
