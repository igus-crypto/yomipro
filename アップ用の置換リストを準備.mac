    else
      hashes[[c+"c",a2,a3]] ||= {}
      hashes[[c+"c",a2,a3]][a1]=b
    end
  end
}

puts "hash: #{Time.now - t}"

t = Time.now
sours=hashes.transform_values{|h|
  RegexpTrie.union(h.keys).to_s
}
puts "trie: #{Time.now - t}"

pat = [
  ["n1a","(?<![《｜])",""],
  ["n1b","(?<![《｜])","(?![一-龯々〇｜]*[《’》])"],
  ["p1a","(?<=[　。「」『』【】─])","(?![一-龯々〇｜]*[《’》])"],
