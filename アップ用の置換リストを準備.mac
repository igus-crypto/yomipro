  ["p3a","(?<![《ａ-ｚＡ-Ｚ》｜])","(?![《ａ-ｚＡ-Ｚ》])"],
  ["p4a","(?<![《a-zA-Z》｜])","(?![《a-zA-Z》])"],
  ["p5a","(?<![《一-龯々〇｜》])","(?![一-龯々〇｜]*[《’》])"],
  ["p5b","(?<![《一-龯々〇｜》])","(?![《’》])"],
  ["p6a","(?<![《｜])","(?![《一-龯々〇｜》])(?![一-龯々〇｜]*[《’》])"],
  ["p6b","(?<![《｜])","(?![《一-龯々〇｜》])"],
  ["p7a","(?<![《一-龯々〇｜》])","(?![《一-龯々〇｜》])(?![一-龯々〇｜]*[《’》])"],
  ["p7b","(?<![《一-龯々〇｜》])","(?![《一-龯々〇｜》])"],
  ["p8a","(?<![《｜])","(?![一-龯々〇｜]*[《’》])"],
  ["p8b","(?<![《｜])","(?![《’》])"],
  ["p8c","(?<![《｜])",""],
].map{|a,b,c| [a,[b,c]]}.to_h

# rep01 を Hash 化
rep01=rep01.split(%r|\R|)
rep01.shift
print "rep01=";p rep01
rep01=rep01.map{|e| e.split(",")}.to_h

# rep02 を Hash 化
rep02=rep02.split(%r|\R|)
rep02.shift
hash={}
rep02.each{|line|
  line=line.force_encoding("UTF-8")
  o,r,rep=line.split(",",3)
  next unless o && r
  if rep
    hash[[o,r]]=rep
  else
    hash[[o,r]]=""
  end
  next if r==r.tr2 or %r|^[+]|=~r
  r=r.tr2
  if rep
    hash[[o,r]]=rep
  else
    hash[[o,r]]=""
  end
}
rep02=hash

rep14=rep14.split(%r|\R|).map{|e|e.split(",", 2)}.reject(&:empty?).to_h.
  transform_keys{|k|k.split("-").map{|f|f.to_i}}

ar01=[
  ["》([一-龯々〇]*《)",'》｜\1'],
  ["｜([^《。｜》]+)《》",'\1'],
  ["｜([一-龯々〇]+)《》",'\1'],
  ["《》",""]]
ar02=[
  ["《（","《"],
  ["）》","》"],
