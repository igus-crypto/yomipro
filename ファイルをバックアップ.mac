//ファイルをバックアップ.mac

#x=x;#y=y;$f=filename+"~";selectall;copy;moveto #x,#y;
// message $f+"\nにバックアップファイルを作成しました";
runsync2 "rubyw -x "+currentmacrofilename+ " "+filename;
execmacro directory + "\\tmp.mac";
endmacro;

