//ファイル分割.mac

setmenudelay 50;
mousemenu
"&1 【１時間】",              // 1
"&2 【２時間】",              // 2
"&3 【分割位置検討】",        // 3
"&- 【======】";              // 4

if(result==0){endmacro;}
else{#r=result;}

#x=x;#y=y;
if(#r==3){
  $s=getselectedtext();
  selectall;copy;moveto #x,#y;escape;
  runsync2 "rubyw -x "+currentmacrofilename+" "+filename +" 3 "+$s;
  openfile "tmp_b.txt";
}else{
  selectall;copy;moveto #x,#y;
  runsync2 "rubyw -x "+currentmacrofilename+" "+filename +" "+str(#r);
  runsync2 directory+"\\touch.bat";
  runsync2 directory+"\\filesize.bat";
}
endmacro;

