ar,i,st,d=s0.split(/\R/),1,"","00"
f=File.basename(ARGV[0])
r=ARGV[1].to_i
s=ARGV[2]

#p f
#p sprintf("%02d",i)

if r==3
  s="章】　─" unless s
  a0=s0.split(s).map{|e| e.size}
  print "a0=";p a0
  a0[1]=a0[0]+a0[1]
  a0=a0[1..-1]
  print "a0=";p a0
  t=""
