  t+="\n合計:"+sprintf("%07d",a0.sum)+"\n"
  File.write("tmp_b.txt",t)
elsif r==4
  ar.each{|e|
    if %r|^======|=~e
      d=sprintf("%02d",i)
      FileUtils.mkdir(d) unless FileTest.directory?(d)
      #File.mkdir(d)
      File.write(d+"/"+f,st)
      i,st=i+1,""
    else
      st=st+e+"\n"
    end
  }
else
  ar.each{|e|
    #p e if %r|^[。◇ 　]*$|=~e
    #p (st+e).size
    if %r|^[。◇ 　]*$|=~e and (st+e).size>36300*r
      d=sprintf("%02d",i)
      FileUtils.mkdir(d) unless FileTest.directory?(d)
      #File.mkdir(d)
      File.write(d+"/"+f,st)
      i,st=i+1,""
    end
    st=st+e+"\n"
  }
end
d=sprintf("%02d",i)
FileUtils.mkdir(d) unless FileTest.directory?(d)
File.write(d+"/"+f,st)

st1= <<EOS
REM filesize.bat
chcp 65001

ruby -x "%~f0"
start size.txt
goto end

#!ruby
#encoding: utf-8
Encoding.default_external = 'UTF-8'

$stdout=open("size.txt","w")
$stderr=open("tmp_z.log","w")
Dir.glob(%Q|[0-9][0-9]/|+%Q|s.txt|){|f|
  z=File.size(f)
  h=(z/1652.0)/60
  m=(z/1652.0)%60
  puts f+":"+sprintf("%6d",z.to_i)+
    ":"+sprintf("%2d",h.to_i)+"h"+sprintf("%2d",m.to_i)+"m"
}
__END__
:end
EOS

File.write("filesize.bat",st1)

