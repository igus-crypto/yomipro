opt=ARGV[0]
arr=cbd.getText.
  split("\r\n").grep_v(/^―*$|^最終更新日：/).uniq
print "arr=";p arr

st=cbd.getText
print "st=";p st
st=arr.compact.uniq.sort_by{|e| -e.size}.
  group_by{|e| e.sub(%r|([^\p{Han}]*)(\p{Han}*).*|){$2}}.
  to_a.transpose[1].to_a.map{|e| e.map{|f|
    f=f.gsub(%r|^[　。「」『』（）【】─※◇・、]|,"　").gsub(%r|(?<=[,])[　。、「『]|,"　")
    t=[]
    t << f
    if %r|^　|=~f
      #t << f.gsub(%r|^　|,"　").gsub(%r|(?<=[,])　|,"　")
      t << f.gsub(%r|^　|,"。/").gsub(%r|(?<=[,])　|,"。/")
      t << f.gsub(%r|^　|,"「").gsub(%r|(?<=[,])　|,"「")
      t << f.gsub(%r|^　|,"『").gsub(%r|(?<=[,])　|,"『")
      t << f.gsub(%r|^　|,"─").gsub(%r|(?<=[,])　|,"─")
      t << f.gsub(%r|^　|,"、").gsub(%r|(?<=[,])　|,"、")
      t << f.gsub(%r|^　|,"が").gsub(%r|(?<=[,])　|,"が")
      t << f.gsub(%r|^　|,"は").gsub(%r|(?<=[,])　|,"は")
      t << f.gsub(%r|^　|,"").gsub(%r|(?<=[,])　|,"")
    end
    print "t=";p t
    t}.uniq.join("\n")}.join("\n\n")+"\n"
cbd.setText(st)

__END__
