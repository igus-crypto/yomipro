//選択を行末にコピー

//標準            :ルビチェック用
//alt             :＋に括弧
//ctrl            :そのまま
//shift           :ひらがな
//ctrl+shift      :漢字+カタカナ

//begingroupundo;disabledraw;
if((!selecting) && (code==44)){
  #x=x;#y=y;golinetop;insert "!";moveto #x+1,#y;endmacro;}
#ty=screentopy;
disabledraw;begingroupundo;
if(!imestate)imeswitch; //全角入力
#fc=0;#fs=0;#fa=0;
if(iskeydown(0x12))#fa=1;
if(iskeydown(0x11))#fc=1;
if(iskeydown(0x10))#fs=1;
if(x==0)selectline 1;

//if(#fs && code==13){selectline 1;#fs=0;}
if(x==0){#fs=1;}
if(code==13){selectline 1;#fs=0;}

if(#fc && #fs){
  if(!selecting){gowordtop2;beginsel;gowordend2;}
  call copyfile;
  runsync2 "rubyw -x "+currentmacrofilename+" ga";
}else if(#fa){
  call copyfile;
  runsync2 "rubyw -x "+currentmacrofilename+" gk";
}else if(#fc){
  if(!selecting){gowordtop2;beginsel;gowordend2;}
  call copyfile;
  runsync2 "rubyw -x "+currentmacrofilename+" gc";
}else if(#fs){
  if(!selecting){gowordtop2;beginsel;gowordend2;}
  call copyfile;
  runsync2 "rubyw -x "+currentmacrofilename+" gs";
}else{
  //if(!selecting){beginsel;wordleft;}
  if(!selecting){golineend2;insert ",+";endmacro;}
  call copyfile;
  runsync2 "rubyw -x "+currentmacrofilename+" gm";
}
execmacro directory + "\\tmp.mac";
#x=x;#y=y;
//message str(#ty)+"/"+str(screentopy);
if(#ty!=screentopy){gofileend;moveto #x,#y;}
endgroupundo;enabledraw;endmacro;

copyfile:
disabledraw;
#x=x;#y=y;#px=seltopx;#py=seltopy;#dx=selendx;#dy=selendy;
if(#x==#px && #y==#py){escape;moveto #px,#py;beginsel;moveto #dx,#dy;}
copy2;selectline 1;
#px=seltopx;#py=seltopy;#dx=selendx;#dy=selendy;
$sel=gettext(#px,#py,#dx,#dy,1,1);
openfile "/h";
insert $sel;
saveas currentmacrodirectory+"\\tmp99gm.txt";
#hwnd=hidemaruhandle(0);
setactivehidemaru 1;closehidemaruforced #hwnd;
return;

