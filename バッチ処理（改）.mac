//バッチ処理（改）

selectall;copy;
runsync2 "ruby -x "+currentmacrofilename;
execmacro directory+"\\tmp.mac";
endmacro;

/*
#/
#! ruby
# encoding: utf-8
Encoding.default_external = Encoding::UTF_8
Encoding.default_internal = Encoding::UTF_8

$stderr=open("tmp_eb.txt","w")
$stdout=open("tmp99b.txt","w")
require 'clipboard'
require 'pp'

STDOUT.puts "作業開始"

mar=Marshal.load(File.binread(__dir__+"/replace/rep.dat"))
HAS,TRI,PAT=mar[0]
REP01,REP02,REP14=mar[1]
AR01,AR02,AR03,AR11,AR12,AR13,AR14,AR15=mar[2]
RE01,RE02,RE03,RE04,RE05,RE06,RE07,RE08,RE09,RE10=mar[3]
ST01,ST02,ST03,ST04,ST05,ST06,ST07=mar[4]
#HAS,TRI,PAT,a01,a02,rep01,rep02= Marshal.load(File.binread(__dir__+"/replace/rep.dat"))

cbd=ClipBoard.new(__ENCODING__)
text=cbd.getText

class String
  def tr2
    self.tr('ァ-ン','ぁ-ん').
      tr('ぁぃぅぇぉっゃゅょ','あいうえおつやゆよ')
  end
  def gsub_ex
    text,mes=self,0
    HAS.each{|key,value|
      n=key[0][0]+key[0][2..-1]
      if n=="p1a" && mes==0
        STDOUT.puts "直接置換完了"
        mes=1
      end
      before=PAT[n][0]+key[1]
      after =PAT[n][1]+key[2]
      st='\1｜\2'
      hash=value.map{|k,v| [k,v.gsub(%r|《([ぁ-んァ-ヴー])|,'《%\1')]}.to_h
      tri=TRI[key]
      pattern=Regexp.new(before+"("+tri+")"+after)
      text=text.gsub(pattern){|m| "⛑"+hash[m]}
      text=text.gsub(%r|⛑+|,"⛑").
        gsub(%r|([《一-龯々〇｜》])⛑([《一-龯々〇｜》]*[《’》])|,st).gsub("⛑","")
      }
    text
  end
end

STDOUT.puts "置換開始"

# -----------------------------
# 外字取り込み前の処理
# -----------------------------

text="\n"+text
text.gsub!(%r|\r\n|,"\n")
text.gsub!(%r|^-{5,}\n.*?\n-{5,}\n|m,"")
text.gsub!(%r<^[　＊]*$>,"")
text.gsub!(%r<(.)([　]+)(.)>,'\1◇\2\3')
text.gsub!(%r|^\n+|,"\n")
text.gsub!(%r|(.)[ヽゝ]+|){$1*$&.length}
re4=Regexp.new("(.)[ヽゝ]+".force_encoding("UTF-8"))
re5=Regexp.new("(.)[ゞ]+".force_encoding("UTF-8"))
st5="かきくけこさしすせそたちつてとはひふへほ"+
  "カキクケコサシスセソタチツテトハヒフヘホ".force_encoding("UTF-8")
st6="がぎぐげござじずぜぞだぢづでとばびぶべぼ"+
  "ガギグゲゴザジズゼゾダヂヅデトバビブベボ".force_encoding("UTF-8")
text.gsub!(%r|(.)[ゞ]|){$1+$1.tr(st5,st6)}

#注釈除去
#（　＊）のみの行を空行に
AR02.each{|e|
  text.gsub!(e[0],e[1])}
AR03.each{|e|
  re=Regexp.new(e[0])
  text.gsub!(re,e[1])}
text.gsub!(RE06){$1*$&.length}
text.gsub!(RE07){$1+$1.tr(ST04,ST05)}

#直接置換
re=Regexp.union(REP01.keys.sort_by{|s|-s.length})
text.gsub!(re){|m| REP01[m]}

#ルビ除去
text.gsub!(%r|([一-龯々〇]+)《([^《》]+)》|){|m|
  o,r=$1,$2
  t=REP02[[o,r]]
  if t
    t=t.force_encoding("UTF-8")
    a=o+"《"+t+"》"
  else
    m
  end
}

AR01.each{|e|
  text.gsub!(%r|#{e[0]}|,e[1])}

STDOUT.puts "ルビの除去完了"
#symbols[1].each{|e| text=text.gsub_ex(e)} if symbols[1]
#STDOUT.puts "直接置換完了"

text=text.gsub_ex
STDOUT.puts "正規表現の置換完了"

# -----------------------------
# 置換後処理（読み上げ用）
# -----------------------------

AR14.each{|e|
  text.gsub!(%r|#{e[0]}|,e[1])
}

n=0
while 1
  n=n+1
  break unless FileTest.file?("s#{n}.txt")
end
File.write("s#{n}.txt","\uFEFF"+text)
File.write("tmp.mac",%Q|openfile "s#{n}.txt";|)

__END__
*/
