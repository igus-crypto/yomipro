//選択範囲を置換
//alt時には選択文字をクリップボードで

//alt+e:置換の項目に移動
//alt+s:選択した範囲にチェック

if(imestate == 0){imeswitch};
#x=x;#y=y;disabledraw;
if(multiselecting){
  js{
    r=getselectedrange();
    var m1=r.items[0];
    var m2=r.items[1];
    s1=gettext2(m1.col1,m1.line1,m1.col2,m1.line2)
    s2=gettext2(m2.col1,m2.line1,m2.col2,m2.line2)
    hidemaru.setVar("$s1",s1);
    hidemaru.setVar("$s2",s2);
  }
  replaceallfast $s2 ,$s1,nohilight;
  endmacro;
}

if(!selecting){golineend2;beginsel;searchup "=>";right;right;}
$st=getselectedtext();
#alt=0;
if(iskeydown(0x12)){#alt=1;}
if(imestate == 0){imeswitch};
$dir=directory;
$ini=currentmacrodirectory + "\\config.ini";
$uwsc=getinistr($ini,"path","uwsc");
beginclipboardread;$s0=getclipboard;
disabledraw;begingroupundo;
copy2;openfile "/h";paste;
saveas currentmacrodirectory+"\\tmp99gm.txt";
#hwnd=hidemaruhandle(0);
setactivehidemaru 1;closehidemaruforced #hwnd;
runsync2 "rubyw -x "+currentmacrofilename+" "+str(#alt)+" "+$st;
execmacro directory + "\\tmp.mac";
beginclipboardread;$s=getclipboard;
forceinselect 2;
if(#alt)setclipboard $s0;

#sy=screentopy;//message str(#sy);
if(imestate == 0){imeswitch};
run $uwsc+" tmp.uws";
endmacro_postcommand 65;
//execmacro currentmacrodirectory+"\\\\置換ダイアログ.mac";
//以下無効らしい
disabledraw;message str(#sy);
moveto #x,#y;
enabledraw #sy;endgroupundo;

