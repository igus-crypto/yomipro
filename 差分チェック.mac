//差分チェック

$ini=currentmacrodirectory + "\\config.ini";
$uwsc=getinistr($ini,"path","uwsc");

$dir=getarg(0);
$op=getarg(1);
//message $dir;
//message $op;
if($op=="a"){
	#hwnd1 = hidemaruhandle(0);selectall;copy;
	runsync2 $uwsc+" "+currentmacrodirectory+"\\差分チェック.uws "+$dir+" a";
}else{
	#hwnd2 = hidemaruhandle(0);selectall;copy;
	runsync2 $uwsc+" "+currentmacrodirectory+"\\差分チェック.uws "+$dir;
	if(existfile($dir+"\\tmp_diff1.txt")){
		setactivehidemaru #hwnd1;begingroupundo;selectall;delete;paste;save;endgroupundo;}}



