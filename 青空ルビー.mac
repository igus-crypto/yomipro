  ["(?<=[ァ-ヴー])([-])(?=[ァ-ヴー])","’"]]
a13=a13.map{|e| e.map{|f| f.force_encoding("UTF-8")}}

a11.each{|e|
  re1=Regexp.new(e[0])
  text.gsub!(re1,e[1])
}

unless RUBY_PLATFORM =~%r|wasm|
  n=1
  while 1
    break if FileTest.file?("s#{n}.txt")
