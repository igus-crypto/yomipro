re=Regexp.new("^\s*$")
st="◇。◇。◇。".force_encoding("UTF-8")
text.gsub!(re,st)

a11=[ # 置換後処理（読み上げ用）（正規表現）
  ["^　　+",""],
  ["^([　]*)([０-９七三九二五八六十四一]+)([　]*)$",
