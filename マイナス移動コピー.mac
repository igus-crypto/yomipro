    else
      ar[1]=ar[1].to_s.sub(%r|^([^\p{Han}]+)([\p{Han}])|){$1+"’"+$2}
    end
    s=ar.join.gsub(%r|\R|,"")+"\n"
    puts s
    if %r|’|!~s
      break
    else
      a << s
      st=s
    end
  end
end
print "a=";p a
puts a.join
cbd.setText(a.join)
__END__
