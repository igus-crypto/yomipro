opt1=ARGV[0]
opt2=ARGV[1]

cbd = ClipBoard.new(__ENCODING__)
st=cbd.getText
print "st=";puts st
if %r|n|=~opt2
  if %r|n|=~opt1
    if /[-]/=~st
      st=st.split(%r|\n+|).join.gsub(%r|\R|,"") +"\n"
    else
