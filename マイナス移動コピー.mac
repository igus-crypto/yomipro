    end
  end
  print "st=";puts st
  a=[st.gsub("-","")]
  a << st
  while 1
    s=st.gsub(%r|\-([ぁ-んァ-ヴー・])|,'\1-')
    puts s
    if s==st
      break
    else
      a << s
      st=s
    end
  end
else
  if %r|n|=~opt1
  a=[st.split(%r|\R|).join.gsub(%r|\R|,"")+"\n"]
    if /’/=~st
      st=st.split(%r|\R|).join.gsub(%r|\R|,"")+"\n"
    else
      ar=st.split(%r|\R|)
      print "ar=";p ar
      ar[1]=ar[1].to_s.sub(%r|^([^\p{Han}]*)([\p{Han}])|){$1+"’"+$2}
      st=ar.join.gsub(%r|\R|,"") +"\n"
    end
  end
  print "st=";puts st
