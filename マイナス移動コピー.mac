//マイナス移動コピー

//標準:マイナスを移動コピー
//alt :「’」を移動コピー

disabledraw;
$s="s";$a="n";
if(iskeydown(0x12))$a="a"; //ALT
if(selecting){selectline 1;cut;}
else{insert "\n";golineend2;beginsel;up_nowrap;golinetop2;cut;$s="n";}
runsync2 "rubyw -x "+currentmacrofilename+" "+$s+" "+$a;
paste;
if($s=="n"){backspace;down_nowrap;golinetop2;}
enabledraw;endmacro;

/*
#/
#! ruby

$stdout=open("tmp99.txt","w")
$stderr=open("tmp_err.txt","w")

