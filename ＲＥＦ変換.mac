//ＲＥＦ変換

disabledraw;begingroupundo;
if(!selecting)selectline 1;
copy2;
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmp.mac";
endgroupundo;enabledraw;

