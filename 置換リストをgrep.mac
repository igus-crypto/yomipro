word.each{|e|
  mc+=%Q|setsearch "#{e}" , 0x4003809;\n|
  mc+=%Q|colormarkerallfound 0x000000, #color[#{i%16+1}], 11, 1;\n|
  i+=1}
mc+=%Q|gofiletop;enabledraw;save;
setactivehidemaru findhidemaru("#{ofl}");
