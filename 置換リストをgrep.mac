//置換リストをgrep

if(selecting==0){endmacro;}else{#shi=0;}
if(iskeydown(0x10)){#shi=1;}
if(rectselecting){
  disabledraw;
  #tx=seltopx;#ty=seltopy;#ex=selendx;#ey=selendy;
  #ix=seltopy;#iy=seltopy;#f=0;
  escape;
  $c=getcolormarker(0x0002);$s="";
  //message $c;endmacro;
  moveto #tx,#ty;
  while(#iy<=#ey){
    if(code==eof){break;}
    moveto #tx,#iy;
    while(x<=#ex){
      $c=getcolormarker(0x0002,findmarker);
      if($c!="" && #f==0){beginsel;#f=1;}
      else if($c=="" && #f==1){$s=$s+getselectedtext()+"\n";escape;#f=0;}
      else if(code==13 && #f==1){$s=$s+getselectedtext()+"\n";escape;#f=0;break;}
      else if(code==13){break;}
      #ix=x;right;
      if(x==#ix){#f=2;break;}
    }
    if(#f==2){break;}
    #iy=#iy+1;
  }
  //message $s;
  moveto #tx,#ty;escape;
  enabledraw;
  openfile "/h";insert $s;saveas "tmp_t.txt";selectall;copy;
  #hwnd=hidemaruhandle(0);
  setactivehidemaru 1;closehidemaru #hwnd;
  runsync2 "rubyw -x "+currentmacrofilename+" r";
}else if(seltopy==selendy){
  copy;
  //run "rubyw "+currentmacrodirectory+"\\\\grep2.rbw h";
  runsync2 "rubyw -x "+currentmacrofilename+" h";
}else if(#shi==1){
  selectline 1;copy;
  //run "rubyw "+currentmacrodirectory+"\\\\grep2.rbw fs";
  runsync2 "rubyw -x "+currentmacrofilename+" fs";
}else{
  selectline 1;copy;
  //run "rubyw "+currentmacrodirectory+"\\\\grep2.rbw f";
  runsync2 "rubyw -x "+currentmacrofilename+" f";
}

execmacro directory + "\\tmp.mac";
endmacro;

