//置換ファイルを操作

#hwnd_a= hidemaruhandle(0);
#c= hidemarucount;
#i=0;$fl="";$fa="";

while(#i<#c){
  if(leftstr(basename[#i],10)=="置換リスト"){
    if($fl=="")setactivehidemaru findhidemaru(filename[#i]);
    $fl=$fl+basename+"\n";
  }else{
    if($fa==""){$fa=basename;}
  }
  #i=#i+1;
}
if($fa=="")endmacro;
if($fl==""){
  execmacro currentmacrodirectory+"\\\\全ての置換リストをソート.mac";
  runsync2 "rubyw "+currentmacrodirectory+"\\list_check.rbw";
  endmacro;
}

openfile "/h ";insert $fa+"\n";insert $fl;
saveas currentmacrodirectory+"\\tmp_f.txt";#hwnd_t= hidemaruhandle(0);
setactivehidemaru #hwnd_a;closehidemaruforced #hwnd_t;
runsync2 "rubyw -x "+currentmacrofilename;

