//選択範囲を置換
//alt時には選択文字をクリップボードで

if(!selecting)endmacro;
$st=getselectedtext();
#alt=0;
if(iskeydown(0x12)){#alt=1;}
if(imestate == 0){imeswitch};
$dir=directory;
$ini=currentmacrodirectory + "\\config.ini";
$uwsc=getinistr($ini,"path","uwsc");
beginclipboardread;$s0=getclipboard;
disabledraw;begingroupundo;
copy2;openfile "/h";paste;
saveas currentmacrodirectory+"\\tmp99gm.txt";
#hwnd=hidemaruhandle(0);
setactivehidemaru 1;closehidemaruforced #hwnd;
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmp.mac";
beginclipboardread;$s=getclipboard;
forceinselect 2;
if(#alt){
  run $uwsc+" "+currentmacrodirectory+"\\alte.uws";
  setclipboard $s0;
  replacedialog $st ,$st,word,inselect2,nohilight;
}else{
  run $uwsc+" "+currentmacrodirectory+"\\altl.uws";
  replacedialog $s ,$s,word,inselect2,nohilight;
}
enabledraw;endgroupundo;

