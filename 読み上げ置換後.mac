# パターン検索（pオプション）
#                                                  ↓ルビで終わるとき
# p       :                   〇〇                 (?![\p{Han}｜]*《)
# p[0-9]+1:     (?<=[ァ-ヴー])〇〇                 (?![\p{Han}｜]*《)
# p[0-9]+2:     (?<=[ァ-ヴー])〇〇(?![《\p{Han}｜》])
# p[0-9]+3:  (?<![ａ-ｚＡ-Ｚ])〇〇(?![《ａ-ｚＡ-Ｚ])
# p[0-9]+4:      (?<![a-zA-Z])〇〇(?![《a-zA-Z])
# p[0-9]+5: (?<![《\p{Han}》])〇〇                 (?![\p{Han}｜]*《)
# p[0-9]+6:                   〇〇(?![《\p{Han}｜》])
# p[0-9]+7: (?<![《\p{Han}》])〇〇(?![《\p{Han}｜》])
# p[0-9]+8:                   〇〇                 (?![\p{Han}｜]*《)
# p[0-9]+9:                   〇〇
# 正規表現オプションのある場合（rオプション）
# r:マッチ部に「《》」があれば処理しない ⇒ マッチ評価時に対応
# r:/[\p{Han}]/で終わる場合、後ろの文字が /[\p{Han}]*《/なら処理しない
# オプション r:ルビ付き t:ルビ展開 の時は除く
rp.each_with_index{|e,i|
  print "e=";p e
  print "oya=";p oya[i]
  print "ruby=";p ruby[i]
  if /^y/=~e
    oya[i]="(?<!《)"+oya[i] #+"(?![\\p{Han}｜]*《)"
  elsif e==nil # && /》$/=~ruby[i]
  #elsif e==nil && /》$/=~ruby[i]
    oya[i]=oya[i] +"(?![\\p{Han}]*《)"
  elsif /p(?!\d)/=~e && /》$/=~ruby[i]
    oya[i]=oya[i] +"(?![\\p{Han}｜]*《)"
  elsif /p\d*1$/=~e
    oya[i]="(?<=[　。「」『』（）【】─※◇・‥])"+oya[i] +"(?![\\p{Han}｜]*《)"
  elsif /p\d*2$/=~e
    oya[i]="(?<=[ァ-ヴー])"+oya[i]+"(?![《\\p{Han}｜》])"
  elsif /p\d*3$/=~e
    oya[i]="(?<![ａ-ｚＡ-Ｚ])"+oya[i]+"(?![《ａ-ｚＡ-Ｚ])"
  elsif /p\d*4$/=~e
    oya[i]="(?<![a-zA-Z])"+oya[i]+"(?![《a-zA-Z])"
  elsif /p\d*5$/=~e
    oya[i]="(?<![《\\p{Han}》])"+oya[i] #+"(?![\\p{Han}｜]*《)"
  elsif /p\d*6$/=~e
    oya[i]=oya[i]+"(?![《\\p{Han}｜》])"
  elsif /p\d*7$/=~e
    oya[i]="(?<![《\\p{Han}》])"+oya[i]+"(?![《\\p{Han}｜》])"
  elsif /p\d*8$/=~e
    oya[i]=oya[i] +"(?![\\p{Han}｜]*《)" if /》$/=~ruby[i]
  elsif /p\d*9$/=~e
    oya[i]=oya[i]
  elsif /ry/=~e && /》$/=~ruby[i]
    oya[i]=oya[i] +"(?![\\p{Han}｜]*《)"
  elsif /ry/=~e
    oya[i]=oya[i] +"(?![\\p{Han}｜]*《)"
  else
    e
  end
  print "oya[i]=";p oya[i]
  print "e=";p e
  unless /[rs]|^y|p[0-9]+[34]/=~e
    if /[\\p{Han}｜]$/=~oya[i]
      oya[i]=oya[i]+"(?![\\p{Han}｜]*《)"
    else
      #oya[i]=oya[i]+"(?![\\p{Han}]*《)"
    end
  end
  print "oya[i]=";p oya[i]
  print "e=";p e
  #rp[i]="r"
  rp[i]="w" unless rp[i]
}

