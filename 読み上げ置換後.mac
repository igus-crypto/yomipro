  map{|e| e.gsub(%r|^置換リスト[^:]*: |,"").gsub(%r|^[!]+|,"")}

ast,oya1,ruby,com,rp=[],[],[],[],[]
ls.each_with_index{|line,i|
  p line
  if %r|^([^,]*),?([^,]*)?,s.*|=~line
    ast[i],oya1[i],ruby[i],rp[i],com[i]=
      %r|^([^,]*),?([^,]*)?(,s[0-9.]*)?(.*$)?.*|.match(line.chomp).to_a
  elsif %r|^([^,]*),?([^, ]*)?,(?:[rsp][^, ]*),(y[^, ]*).*|=~line
    ast[i],oya1[i],ruby[i],rp[i],com[i]=$&,$1,$2,$3
  elsif %r|^([^,]*),?([^, ]*)?,([rspy][^, ]*).*|=~line
    ast[i],oya1[i],ruby[i],rp[i],com[i]=$&,$1,$2,$3
  else
    line2=line.gsub(/\([^()]*\)/){|s| s.gsub(" ","_spc_").gsub(",","_cmm_")}.
      gsub(/\{[^{}]*\}/){|s| s.gsub(" ","_spc_").gsub(",","_cmm_")}.
      gsub(/《[^《》]*》/){|s| s.gsub(" ","_spc_").gsub(",","_cmm_")}.
      gsub(/｜[^《]*《/){|s| s.gsub(" ","_spc_").gsub(",","_cmm_")}
    ast[i],oya1[i],ruby[i],rp[i],com[i]=
      /^([^,]*),?([^, ]*)?(,[rspy][0-9.]*)?(.*$)?/.match(line2.chomp).to_a
    ast[i]=line
  end}
