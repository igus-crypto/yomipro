cbd = ClipBoard.new(__ENCODING__)

def bsize(txt)
  txt.to_s.tr("—","-").split("").map{|e| e.bytesize==1 ? 1 : 2}.sum
  #"—"は３バイト,"-"は１バイトという罠回避
end

class String
  def del_oya
    st=self.gsub(/《[+%!~]([^《》]*)》/,'《\1》').gsub(/｜([^《》]+)《[=#][^《》]*》/,'\1').
      gsub(/｜[^《》]+《([^《》]*)》/,'\1').gsub(/([\p{Han}])(《[=#][^《》]*》)/,'\1').
      gsub(/([^\p{Han}])《[=#]([^《》]*)》/,'\1').gsub(/[\p{Han}]+《([^《》]*)》/,'\1').
      gsub(/.《([^《》]*)》/,'\1').gsub(/^《?([^《》]*)》/,'\1').gsub(/《[^《》]*$/,"")
  end
end

