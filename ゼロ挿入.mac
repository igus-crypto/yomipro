//ゼロ挿入

#shi=0;#ctr=0;#alt=0;
if(iskeydown(0x10))#shi=1;
if(iskeydown(0x11))#ctr=1;
if(iskeydown(0x12))#alt=1;

#n=0;
begingroupundo;disabledraw;#x=x;#y=y;
if(#alt && #shi){
  golinetop2;
  if(code==48)     {#n=1;delete;#x=#x-1;}
  else if(code==49){#n=2;delete;#x=#x-1;}
  else if(code==50){#n=3;delete;#x=#x-1;}
  else if(code==51){#n=4;delete;#x=#x-1;}
  else if(code==52){#n=5;delete;#x=#x-1;}
  else if(code==53){#n=6;delete;#x=#x-1;}
  else if(code==54){#n=7;delete;#x=#x-1;}
  else if(code==55){#n=8;delete;#x=#x-1;}
  else if(code==56){#n=9;delete;#x=#x-1;}
  else if(code==57){#n=0;delete;#x=#x-1;}
  insert str(#n);
  moveto #x+1,#y;
}else if(#alt && #ctr){
  golinetop2;
  if(code==33){delete;#x=#x-1;}
  else{insert "!";#x=#x+1;}
  moveto #x,#y;
}else{
  golineend2;left;
  if(code==48)     {#n=1;delete;}
  else if(code==49){#n=2;delete;}
  else if(code==50){#n=3;delete;}
  else if(code==51){#n=4;delete;}
  else if(code==52){#n=5;delete;}
  else if(code==53){#n=6;delete;}
  else if(code==54){#n=7;delete;}
  else if(code==55){#n=8;delete;}
  else if(code==56){#n=9;delete;}
  else if(code==57){#n=0;delete;}
  else{right;}
  insert str(#n);
  moveto #x,#y;
}
endgroupundo;enabledraw;
endmacro;

begingroupundo;
setmenudelay 300;
mousemenu
"&0 0",      // 1
"&1 1",      // 2
"&2 2",      // 3
"&3 3",      // 4
"&4 4",      // 5
"&5 5",      // 6
"&6 6",      // 7
"&7 7",      // 8
"&8 8",      // 9
"&9 9";      //10

//message str(result);
if(result==0){endmacro;
}else if(result==1){
  insert "0";
}else if(result==2){
  insert "1";
}else if(result==3){
  insert "2";
}else if(result==4){
  insert "3";
}else if(result==5){
  insert "4";
}else if(result==6){
  insert "5";
}else if(result==7){
  insert "6";
}else if(result==8){
  insert "7";
}else if(result==9){
  insert "8";
}else if(result==10){
  insert "9";
}
endgroupundo;endmacro;

