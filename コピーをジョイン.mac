//コピーをジョイン

//0x10:shift
#shi=0;
if(iskeydown(0x10)){#shi=1;}

#x=x;#y=y;
if(#shi==1){
  copy;
  runsync2 "rubyw -x "+currentmacrofilename+" s";
}else{
  setmenudelay 700;
  mousemenu
  "&C コピー",          // 1
  "&X クロス",          // 2
  "&F ファイル名",      // 3
  "&V コピペ";          // 4
  #res=result;
  if(#res==0){endmacro;
  }else if(#res==1){   //【C】 コピー
    if(selecting){
      copy;
    }else{
      disabledraw;escape;searchup "《";beginsel;searchdown "》";
      right;copy;moveto #x,#y;enabledraw;
    }
  }else if(#res==2){   //【X】 コピー２
    copy
    runsync2 "rubyw -x "+currentmacrofilename+" x";
  }else if(#res==3){   //【F】 ファイル名
    setclipboard filename;
  }else if(#res==4){   //【V】 コピペ
    copy;insert "\n";paste;
  }
}

