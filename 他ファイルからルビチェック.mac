//他ファイルからルビチェック

runsync2 "rubyw -x "+currentmacrofilename+" a";
execmacro directory +"\\tmp_a.mac";
runsync2 "rubyw -x "+currentmacrofilename+" b";
execmacro directory +"\\tmp_t.mac";
endmacro;
