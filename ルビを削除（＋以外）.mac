//ルビを削除（＋以外）

setcompatiblemode 0x20050;
begingroupundo;
#x=x;#y=y;
if(!selecting)selectall;cut;
runsync2 "rubyw -x "+currentmacrofilename;
paste;endgroupundo;moveto 0,#y;endmacro;

