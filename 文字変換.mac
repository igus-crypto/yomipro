$stderr=open("tmp_err.txt","w")

Dir.chdir(__dir__)
st="\uFEFF"
#st+=%Q|selectline 1;\n|
st+=%Q|execmacro currentmacrodirectory+"\\\\文字変換.mac","#{ARGV[0]}";\n|
File.write("yomi.mac",st) unless /^rc|^ri/=~ARGV[0]

__END__
