//ルビ、オプション除去

$opt="n";
if(iskeydown(0x11)){$opt=$opt+"c";}
if(iskeydown(0x10)){$opt=$opt+"s";}

if(imestate==1)imeswitch;
begingroupundo;disabledraw;
if(selecting){}else{beginsel;searchup ",";}
cut;#fg=getclipboardinfo(1);
runsync2 "rubyw -x "+currentmacrofilename+" "+$opt;
if(#fg){pasterect;}else{paste;}
enabledraw;endgroupundo;


