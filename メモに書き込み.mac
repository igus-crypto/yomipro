//メモに書き込み(Ctrl+X E)

setmenudelay 700;
mousemenu
"&E memo.txt",                           // 1
"&A a0.txt",                             // 2
"&g gosyoku.txt",                        // 3
"&k koko.txt",                           // 4
"&T 置換リストにコピペ（ＢＧ処理）";     // 5
#res=result;
if(#res==0)endmacro;

#shi=0;#ctr=0;#alt=0;
if(iskeydown(0x10)){#shi=1;}
if(iskeydown(0x11)){#ctr=1;}
if(iskeydown(0x12)){#alt=1;}

if(#res==4){
  disabledraw;
  #x=x;#y=y;
  $c=gettext(seltopx,seltopy,selendx,selendy,1);
  beginsel;gofiletop;
  $a=gettext(seltopx,seltopy,selendx,selendy,1);
  selectall;
  $b=gettext(seltopx,seltopy,selendx,selendy,1);
  escape;moveto #x,#y;
  #a=strlen($a);
  #b=strlen($b);
  runsync2 "rubyw -x "+currentmacrofilename+" "+str(#res)+" "+str(#a)+" "+str(#b);
  enabledraw;
  execmacro directory + "\\tmp.mac";
  begingroupundo;gofileend;insert "\n"+$c+"\n";
  paste;insert "\n";endgroupundo;
  endmacro;
}else if(#res==5){
  if(!selecting)endmacro;
  selectline 1;wordleft;copy;
  runsync2 "rubyw "+currentmacrodirectory+"\\sort4.rbw b";
  execmacro directory + "\\tmp.mac";
  endmacro;
}

if(#shi==1 && #ctr==1){
  if(selecting){copy2;}else{#x=x;#y=y;selectall;copy;moveto #x,#y;}
  runsync2 "rubyw "+currentmacrodirectory+"\\moji_count.rbw";
  runsync2 "rubyw -x "+currentmacrofilename+" "+str(#res)+" s";
  execmacro directory + "\\tmp.mac";endmacro;
}else{
  runsync2 "rubyw -x "+currentmacrofilename+" "+str(#res)+" n";
  execmacro directory + "\\tmp.mac";
}
endmacro;

