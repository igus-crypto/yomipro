//ルビのgrep
//ファイル選択

setcompatiblemode 0x20020;

$inifile=currentmacrodirectory + "\\config.ini";

runsync2 "rubyw -x "+currentmacrofilename+" b "+filename;

endmacro;

//標準  :ファイル選択
//shift :編集中のファイルを対象にする

#fs=0;
if(iskeydown(0x10))#fs=1;

if(#fs){
  runsync2 "rubyw -x "+currentmacrofilename+" b "+filename;
}else{
  openfile "/h /r .\\*.txt";
  #hwnd_f1 = hidemaruhandle(0);
  $f1=filename;
  if ($f1==""){
    setactivehidemaru 1;
    closehidemaruforced #hwnd_f1;
    runsync2 "rubyw -x "+currentmacrofilename+ " msg";
    beginclipboardread;$f1=getclipboard();
    message "対象ファイルは　"+$f1+"　です";
    endmacro;
  }
  
  beginclipboardread;setclipboard $f1;
  runsync2 "rubyw -x "+currentmacrofilename+" a";
  $f1=getclipboard();
  
  openfile $inifile;
  closehidemaruforced #hwnd_f1;
  begingroupundo;
  searchdown "file_1=";
  golineend2;deletebefore;
  insert "file_1="+$f1;
  golinetop;endgroupundo;save;
}
endmacro;

