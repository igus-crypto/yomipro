col=ar.grep(%r|color_#{n}=|)[0]
print "col=";p col
col+=1 if col==0
col=col.to_s.gsub(%r|color_#{n}=|,"")
col="0x"+col
#mac=File.expand_path(__dir__+"/tmp.mac")
mac="tmp.mac"
print "mac=";p mac
mc="\uFEFF"
ag.each{|e|
  mc+=%Q|setsearch "#{e}" ,0x00003800;\n|
  mc+=%Q|colormarkerallfound 0x000000,#{col},-1,0,0;escape;\n|
  }
mc+=%Q|endmacro;\n|

