//棒読み文庫.mac
//message str(code);endmacro;
$ini=currentmacrodirectory + "\\棒読み文庫.ini";
#bfr  =val("0x"+getinistr($ini,"color","bfr"));
#aft  =val("0x"+getinistr($ini,"color","aft"));
#feed =val(getinistr($ini,"sleep","feed"));
#pause=val(getinistr($ini,"sleep","pause"));
#line =val(getinistr($ini,"etc","line"));
#speak=val(getinistr($ini,"etc","speak"));

setmenudelay 300;
mousemenu
"&A 読み上げ",            // 1
"&B 背景色変更",          // 2
"&C 背景色クリア",        // 3
"&L 改ページ行数調整";    // 4

if(result==0){endmacro;
}else if(result==1){  //読み上げ
    //message str(code);endmacro;
    while(1){
      if(#speak==1){
        disabledraw;
        escape;beginsel;#x03=x;#y03=y;#c03=column;
        searchdown "。$|(?<!◇)。|$" ,regular;
        #x04=x;#y04=y;#c04=column;#l04=lineno;
        $sel=gettext(seltopx,seltopy,selendx,selendy);
        if($sel==""){endmacro;}
        #h1=hidemaruhandle(0);
        openfile "/h";insert $sel;
        #h2=hidemaruhandle(0);
        saveas currentmacrodirectory+"\\tmp99y.txt";
        setactivehidemaru #h1;moveto #x03,#y03;
        closehidemaruforced #h2;
        runsync2 "rubyw -x "+currentmacrofilename;
        enabledraw;beginsel;
      }
      //message str(#x02)+"/"+str(#y02);
      while(column<=#c04 && lineno<=#l04){
        if(code==32){right;} //半角スペース
        else if(code==13 && y==0){ //一行目行末
          right;sleep #pause;
          colormarker 0x000000, #aft, 11, 1;
          break;} 
        else if(code==45){ //-
          right;}
        else if(code==33182){ //◇
          right;if(code==33090)right;sleep #feed;
          colormarker 0x000000, #aft, 11, 1;}
        else if(code==33090){ //。
          right;sleep #pause;#x1=x;#y1=y;
          colormarker 0x000000, #aft, 11, 1;
          escape;
          disabledraw;goscreentop;#x2=x;#y2=y;
          moveto #x1,#y1;enabledraw;
          if(#y1-#y2>#line){halfnextpage;sleep #pause;}
          moveto #x1,#y1;beginsel;
          if(code==13){right;
          colormarker 0x000000, #aft, 11, 1;
          escape;beginsel;}}
        else if(code==13){ //行末
          right;sleep #pause;#x1=x;#y1=y;
          colormarker 0x000000, #aft, 11, 1;
          escape;
          disabledraw;goscreentop;#x2=x;#y2=y;
          moveto #x1,#y1;enabledraw;
          if(#y1-#y2>#line){halfnextpage;sleep #feed;}
          moveto #x1,#y1;beginsel;}
        else{right;sleep #feed;}
    }
  }
}else if(result==2){  //背景色変更
  disabledraw;#x=x;#y=y;selectall;
  colormarker 0x000000, #bfr, 11, 1;
  escape;moveto #x,#y;enabledraw;
}else if(result==3){  //背景色クリア
  disabledraw;#x=x;#y=y;selectall;
  colormarker 0x000000, 0xffffff, 11, 1;
  escape;moveto #x,#y;enabledraw;
}else if(result==4){  //改ページ行数調整
  #x=x;#y=y;
  disabledraw;goscreentop;#y1=y;
  goscreenend;#y2=y;
  moveto #x,#y;
  runsync2 "rubyw -x "+currentmacrofilename+" "+str(#y2-#y1);
}
endmacro;

