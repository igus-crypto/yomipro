//フィードバック準備

runsync2 "rubyw -x "+currentmacrodirectory+"\\\\名前をつけて保存.mac s";
execmacro directory + "\\tmp_a.mac";
execmacro currentmacrodirectory+"\\\\日付フォルダを作成してコピー.mac";
disabledraw;begingroupundo;
execmacro currentmacrodirectory+"\\「%」など削除.mac";
replaceallfast "《[+]","《",regular;
replaceallfast "、《、/》(.)","、\\1《/\\1》",regular;
runsync2 "rubyw -x "+currentmacrofilename;
gofiletop;endgroupundo;enabledraw;save;
runsync2 "rubyw -x "+currentmacrofilename+" "+filename;
endmacro;


