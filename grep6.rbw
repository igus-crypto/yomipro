#require 'win32/clipboard'


ini=IniFile.load(__dir__+"/config.ini")
hide=ini["path"]["hide"]
soro=ini["grep"]["soroe"]

$stderr=open("tmp_err.txt","w")
$stdout=open("tmp99.txt","w")
puts Dir.pwd.encode(Encoding::UTF_8)
p soro
print "ARGV=";p ARGV

cbd=ClipBoard.new(__ENCODING__)

#def bsize(txt)
#  txt.to_s.tr("—","-").split("").map{|e| e.bytesize==1 ? 1 : 2}.sum
#  #"—"は３バイト,"-"は１バイトという罠回避
#end
class String
  def bsize
    self.to_s.tr("—","-").split("").map{|e| e.bytesize==1 ? 1 : 2}.sum
    #"—"が実は３バイトという罠回避 "-"は１バイト
  end
end




