齖齗齘齙齚齛齜齝齞齤齥齨齩齫齭齮齯齰齱齳齴齵齸齹齺齻齼齽齾齿
|

g6t=g6t.gsub(/\R/,"")
chk=/[#{g6t}]/

ls,kk=cbd.getText,[]
kk=ls.scan(chk).uniq
print "kk=";p kk
print "ARGV=";p ARGV

if /m/=~ARGV[0] #要注意の漢字をマーク
  macro=open("tmp.mac","w")
  macro.print("\uFEFF")
  macro.puts col
  i=3
  kk.each{|e|
    macro.puts %|setsearch "#{e}" , 0x4003819;|
    macro.puts %|colormarkerallfound 0x000000, #color[#{i%16+1}], 11, 1;|
    i+=1
  }
  exit
end

i=1
while FileTest.file?(ofile="tmps_"+sprintf("%#02d",i)+".txt")
  i+=1
end

ofile=File.expand_path(ofile)
p ofile
ofl=open(ofile,"w")
#p Dir.pwd
fname=ARGV[1].encode(Encoding::UTF_8)
fname=File.basename(fname)


n=15 #前後の文字数

if kk.size>0
  kk.each{|e| 
    ofl.puts e+",｜"+e+"《》"
    ls.split(%r|\R|).each_with_index{|f,i|
      if /#{e}/=~f
        a,b,c=$`,$&,$'
        an=(a[-n,n]||a)
        m=(an.bsize>30 ? 0 : 30-an.bsize)
        m=m+3-i.to_s.size
        print "m=";p m
        m=0 if m<0
        am=" "*m
        ofl.puts am+fname+%Q|:(#{i+1}):|+an+b+
          (c[0,n]).gsub(/(?<=[、。])(.*)/,"")
      end}}
  ofl.puts "\n"
end

ofl.puts "要注意の漢字はありません\n" if kk==[]
ofl.close

mac=File.expand_path("tmp.mac")
p mac

macro=open(mac,"w")
macro.print("\uFEFF")
macro.puts %|openfile "#{ofile}",utf8;|
macro.puts col

i=3
macro.puts %|

//setsearch "(.*?):(\\\\(.*?\\\\)):(.*)" , 0x4003819;
//colormarkerallfound 0x000000, 0xc2c79e, 11, 1;;
setsearch ".*=>.*" , 0x4003819;
colormarkerallfound 0x000000, 0xc2c79e, 11, 1;;
setsearch "(.*?):(\\\\(.*?\\\\)):" , 0x4003819;
colormarkerallfound 0, 0xB2B2F5, 0, 0;

|

kk.each{|e|
  #macro.puts %|setsearch "[亜-龠々｜]*#{e}[亜-龠々]*《[^》]*》" , 0x4003819;|
  macro.puts %|setsearch "#{e}" , 0x4003819;|
  macro.puts %|colormarkerallfound 0x000000, #color[#{i%16+1}], 11, 1;|
  i+=1
}

macro.puts %|

gofiletop;enabledraw;save;endmacro;
|
macro.close

spawn(%Q|"#{hide}" /x "#{mac}"|)

__END__

