//選択文字数挿入

setcompatiblemode 0x00100000;
begingroupundo;disabledraw;
$a="n";
if(iskeydown(0x12)){$a="a";}

#x=x;#y=y;#t=seltopy;#e=selendy;#o=seltopx;
if(#t!=#e){
  copy2;delete;#x1=x;#y1=y;
  runsync2 "rubyw -x "+currentmacrofilename+" 2"+$a;
  escape;paste;
  moveto #x1,#y1;
}else{
  copy2;delete;#x1=x;#y1=y;
  if(#x==#o){
    runsync2 "rubyw -x "+currentmacrofilename+" o"+$a;
  }else{
    runsync2 "rubyw -x "+currentmacrofilename+" x"+$a;
  }
  escape;paste;
  moveto #x1,#y1;
}
  enabledraw;endgroupundo;
endmacro;

