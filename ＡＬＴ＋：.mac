      "0x"+e
    else
      e
    end}
  print "a2=";p a2
  a1.each_with_index{|e,i|
    st+=%Q|setsearch "#{e}" , 0x4003809;\n|
    st+=%Q|colormarkerallfound 0x000000, #{a2[i]}, 11, 1;\n|}
  File.write("tmp_a.mac",st)
elsif /^a/=~opt #【P】 前方を色付け
  cbd = ClipBoard.new(__ENCODING__)
