  print "st=";p st
  ar=st.split(/\R/).reject{|e| e==""}
  ar=ar.map{|e| e.gsub(%r|《\+|,"《").del_oya.gsub(%r|《[^》]*$|,"").
    gsub(%r|.*:?\(?\d*\):|,"").gsub(%r| =>.*|,"").gsub("=","").
    gsub(%r|,?[srp]\d+|,"").gsub(" //"," ,").gsub(/\([^\(\)]+\)/,"").
    gsub(%r|[a-z0-9._]*t::|,"").gsub("◇","▓")}
  print "ar=";p ar
  File.write(send,ar.join("\n")+"\n")
  wsh = WIN32OLE.new('WScript.Shell')
  wsh.run("adb push #{send} #{adb}")
  #wsh.run("adb push #{send} #{adb2}")
  wsh.Popup("#{send} に出力しました",1)
elsif /^8/=~opt #【8】 括弧対応
  c=["0xC786F9","0x72F531","0xFFCB1F","0x7AAFFF",
    "0x4080FF","0xA8A8F9","0xFF80FF","0xFF97B1",
    "0x944DFF","0x29FF77","0x6267F5","0xFF9354",
    "0x957AFF","0xFFE645","0xF9953E","0xFF82E6"]
  mac=""
  #st=open("tmp_k.txt").read.gsub(%r|\R|,"⏬")
  cbd = ClipBoard.new(__ENCODING__)
  st=cbd.getText.gsub(%r|\R|,"⏬")
  a,n=[],0
  while(1)
    a << st.scan(%r|{[^{}]*}|).uniq
    st2=st.gsub(%r|{([^{}]*)}|){"⏩"+$1+"⏪"}
    break if st2==st
    st=st2
    n=n+1
  end
  a=a.flatten.uniq.map{|e| 
    e.gsub("⏬","\n").gsub("⏩","{").gsub("⏪","}").gsub(%r|"|,"\"\"")}
  a=a.group_by{|e| e.gsub(%r|[^}]|,"").size}.to_a.transpose[1].reverse
  print "a=";p a
  a.each_with_index{|e,i| e.each{|f|
      mac+=%Q|setsearch @"#{f}" , 0x4003809;\n|
      mac+=%Q|colormarkerallfound 0x000000, #{c[(n-i)%16]}, 11, 1;\n|}}
  File.write("tmp_a.mac",mac)
  #p st
end

__END__
