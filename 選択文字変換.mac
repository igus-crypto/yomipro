//選択文字変換.mac
disabledraw;copy2;
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmp.mac";
enabledraw;

/*
#/
#! ruby
# encoding: utf-8
Encoding.default_external = 'UTF-8'

$stdout=open("tmp99m.txt","w")
$stderr=open("tmp_errm.txt","w")

require_relative 'clipboard_compat'

cbd = ClipBoard.new(__ENCODING__)

s1=cbd.getText.chomp
p a=DATA.readlines(chomp:1).map{|e| e.split(",")}
s2=s1
a.each{|e| s2=%Q|#{e[1]}| if s1==e[0]}
if s2==s1
  sm=__FILE__.encode(Encoding::UTF_8).gsub("/","\\\\")
  mac =%Q|$sm=@"#{sm}";\n|
  mac+=%Q|if(findhidemaru($sm)==-1)openfile $sm;\n|
  mac+=%Q|setactivehidemaru findhidemaru($sm);\n|
  mac+=%Q|gofileend;searchup "*|+%Q|/";insert "#{s1},#{s1}\\\n";left;left;\n|
  mac+=%Q|endmacro;\n|
else
  cbd.setText(s2.gsub(%r|.*《|,"《"))
  mac=%|insert "#{s2}";|
end
File.write("tmp.mac","\uFEFF"+mac)
__END__
