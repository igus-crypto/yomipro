//ルビ追加

begingroupundo;
#r=selecting;
selectline 1;wordleft;copy;
//runsync2 "rubyw "+currentmacrodirectory+"\\\\convert.rbw rb";
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\\\tmp.mac";
execmacro currentmacrodirectory+"\\\\ルビソート（チェックリスト）.mac";
save;gofiletop;searchdown "《",nohilight;golinetop2;endgroupundo;
if(#r==1)endmacro;
execmacro currentmacrodirectory+"\\\\読み上げプラス確認.mac";
endmacro;

