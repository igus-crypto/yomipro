# REP02 を Hash 化
rep02=rep02.split(%r|\R|)
rep02.shift
hash={}
rep02.each{|line|
  line=line.force_encoding("UTF-8")
  o,r,rep=line.split(",",3)
  next unless o && r
  if rep
    hash[[o,r]]=rep
  else
    hash[[o,r]]=""
  end
  next if r==r.tr2 or %r|^[+]|=~r
  r=r.tr2
  if rep
    hash[[o,r]]=rep
  else
    hash[[o,r]]=""
  end
}
REP02=hash

