#! ruby
# encoding: utf-8
Encoding.default_external = 'UTF-8'

$stdout=open("tmp_s99.txt","w")
$stderr=open("tmp_serr.txt","w")


require 'clipboard'

cbd = ClipBoard.new(__ENCODING__)
opt=ARGV[0].to_i
#opt=0:"/"無し(ALT無し)
#opt=1:"/"有り(ALT)
arr=cbd.getText.
  split("\r\n").grep_v(/^―*$|^最終更新日：/).uniq
print "arr=";p arr

st=cbd.getText
print "st=";p st
a2=[]
a1=arr.compact.uniq.sort_by{|e| -e.size}.
  group_by{|e| e.sub(%r|([^\p{Han}]*)(\p{Han}*).*|){$2}}.
  to_a.transpose[1].to_a.flatten
print "a1=";p a1

a1.each{|e|
  a2 << e
  if    %r<方([ぁ-ん&&[^がでにもを]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("方#{s}","方が").gsub(%r|(方《[^《》]*》)#{s}|){$1+"が"}
  elsif %r<抱([ぁ-ん&&[^いかきくけこ]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("抱#{s}","抱け").gsub(%r|(抱《[^《》]*》)#{s}|){$1+"け"}
  elsif %r<深([ぁ-ん&&[^かきけこいく]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("深#{s}","深か").gsub(%r|(深《[^《》]*》)#{s}|){$1+"か"}
  elsif %r<弾([ぁ-ん&&[^いかきくけこ]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("弾#{s}","弾け").gsub(%r|(弾《[^《》]*》)#{s}|){$1+"け"}
  elsif %r<注([ぁ-ん&&[^がげいぎぐご]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("注#{s}","注が").gsub(%r|(注《[^《》]*》)#{s}|){$1+"が"}
  elsif %r<辛([ぁ-ん&&[^いかきくけさ]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("辛#{s}","辛い").gsub(%r|(辛《[^《》]*》)#{s}|){$1+"い"}
  elsif %r<縁([ぁ-ん&&[^にをがでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("縁#{s}","縁に").gsub(%r|(縁《[^《》]*》)#{s}|){$1+"に"}
  elsif %r<額([ぁ-ん&&[^がにをでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("額#{s}","額が").gsub(%r|(額《[^《》]*》)#{s}|){$1+"が"}
  elsif %r<金([ぁ-ん&&[^がにをでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("金#{s}","金が").gsub(%r|(金《[^《》]*》)#{s}|){$1+"が"}
  elsif %r<風([ぁ-ん&&[^なにでだの]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("風#{s}","風な").gsub(%r|(風《[^《》]*》)#{s}|){$1+"な"}
  elsif %r<主([ぁ-ん&&[^にをとのがでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("主#{s}","主に").gsub(%r|(主《[^《》]*》)#{s}|){$1+"に"}
  elsif %r<柄([ぁ-ん&&[^のにをがでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("柄#{s}","柄を").gsub(%r|(柄《[^《》]*》)#{s}|){$1+"を"}
  elsif %r<種([ぁ-ん&&[^のにをがでも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("種#{s}","種の").gsub(%r|(種《[^《》]*》)#{s}|){$1+"の"}
  elsif %r<家([ぁ-ん&&[^にのはとをでをがも]])(?=$|[,])>=~e
    s=$1;a2 << e.gsub("家#{s}","家に").gsub(%r|(家《[^《》]*》)#{s}|){$1+"に"}
  elsif %r<^([ぁ-ん&&[^がはのにを]])縁(?=[ぁ-ん])>=~e
    s=$1;a2 << e.gsub("#{s}縁","が縁").gsub(%r|(#{s}縁《[^《》]*》)|){"が"+$1}
  end
  }
print "a2=";p a2
a3=a2.map{|e|
  print "e=";p e
  if %r|^[　。「」『』（）【】─※◇・、]|=~e
    e=e.gsub(%r|^[　。「」『』（）【】─※◇・、]|,"　").
      gsub(%r|(?<=[,])[　。「」『』（）【】─※◇・、]|,"　")
