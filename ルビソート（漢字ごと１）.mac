    s=$1;e=e.gsub("#{s}額","の額")
  elsif %r<^([のいうなるた])縁([ぁ-ん])>=~e
    s=$1;e=e.gsub("#{s}縁","の縁")
  elsif %r<方([がでにもを])(?=$|[,])>=~e
    s=$1;e=e.gsub("方#{s}","方が").gsub("方》#{s}","方》が")
  elsif %r<抱([かきけこいく])(?=$|[,])>=~e
    s=$1;e=e.gsub("抱#{s}","抱け").gsub("抱》#{s}","抱》け")
  elsif %r<深([いかきくけこ])(?=$|[,])>=~e
    s=$1;e=e.gsub("深#{s}","深か").gsub("深》#{s}","深》か")
  elsif %r<弾([かくいきけこ])(?=$|[,])>=~e
    s=$1;e=e.gsub("弾#{s}","弾か").gsub("弾》#{s}","弾》か")
