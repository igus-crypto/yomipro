    t << e.gsub(%r|#{s1}#{s2}|,"#{s1}を").gsub(%r|》#{s2}|,"》を") if s2!="を"
  end
  print "t=";p t
  t}
print "a3=";p a3
#a3=a3.reverse.flatten.uniq
a3=a3.flatten.uniq
print "a3=";p a3
a3=a3.each_with_index.sort_by{|s,i|
#  j=3
#  j=2 if %r|家|=~s
#  j=1 if %r|家の|=~s
#  j=0 if %r|家に|=~s
  j=
    if    %r|家に|=~s;  0
    elsif %r|家の|=~s;  1
    elsif %r|家|=~s;    2
    else;               3
    end
  [j,i]
}.map(&:first)
#print "a3=";p a3
a3=a3.reject{|e| %r|^　/|=~e} if opt==0
st=a3.group_by{|e| e.sub(%r|([^\p{Han}]*)(\p{Han}*).*|){$2}}.
  to_a.transpose[1].to_a.map{|e| e.join("\n")}.join("\n\n")+"\n"

cbd.setText(st)

__END__
