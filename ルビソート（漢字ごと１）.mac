//漢字ごとにソート１

#fa=0;
if(iskeydown(0x12))#fa=1; //ALT
begingroupundo;#x=x;#y=y;selectline 1;cut;
runsync2 "rubyw -x "+currentmacrofilename+ " "+str(#fa);
paste;moveto 0,#y;endgroupundo;endmacro;


