  elsif (opt==1 && %r<([\p{Han}])([ぁ-ん])(?=$|[,])>=~e)
    s1,s2=$1,$2
    t << e.gsub(%r|#{s1}#{s2}|,"#{s1}が").gsub(%r|》#{s2}|,"》が") if s2!="が"
