  elsif %r<主([にをとのがでも])(?=$|[,])>=~e
    s=$1;e=e.gsub("主#{s}","主に").gsub("主》#{s}","主》に")
  elsif %r<柄([のにをがでも])(?=$|[,])>=~e
    s=$1;e=e.gsub("柄#{s}","柄を").gsub("柄》#{s}","柄》を")
  elsif %r<種([のにをがでも])(?=$|[,])>=~e
    s=$1;e=e.gsub("種#{s}","種の").gsub("種》#{s}","種》の")
  elsif %r<家([にのはとをでをがも])(?=$|[,])>=~e
    s=$1;e=e.gsub("家#{s}","家に").gsub("家》#{s}","家》に")
  elsif %r<^([がはのにを])縁(?=[ぁ-ん])>=~e
    s=$1;e=e.gsub("#{s}縁","が縁").gsub("#{s}縁《","が縁《")
  elsif (opt==1 && %r<([\p{Han}])([ぁ-ん])(?=$|[,])>=~e)
    s1,s2=$1,$2
    e=e.gsub("#{s1}#{s2}","#{s1}#{s2}").gsub("#{s1}》#{s2}","#{s1}》#{s2}")
  end
  print "e=";p e
  t=[]
  t << e
  if %r|^　|=~e
    t << e.gsub(%r|^　|,"。").gsub(%r|(?<=[,])　|,"。")
    #t << e.gsub(%r|^　|,"「").gsub(%r|(?<=[,])　|,"「")
    #t << e.gsub(%r|^　|,"『").gsub(%r|(?<=[,])　|,"『")
    #t << e.gsub(%r|^　|,"─").gsub(%r|(?<=[,])　|,"─")
    t << e.gsub(%r|^　|,"、").gsub(%r|(?<=[,])　|,"、")
    t << e.gsub(%r|^　|,"が").gsub(%r|(?<=[,])　|,"が")
    t << e.gsub(%r|^　|,"は").gsub(%r|(?<=[,])　|,"は")
  elsif %r<、(?=$|[,])>=~e
    t << e.gsub(%r<、(?=$|[, ])>,"。")
