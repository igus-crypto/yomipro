//前後を削って連続複写

$op="";
if(iskeydown(0x10))$op=$op+"s";
if(iskeydown(0x11))$op=$op+"c";
if(iskeydown(0x12))$op=$op+"a";
if($op=="")$op="n";
//message $op;endmacro;
begingroupundo;selectline 1;cut;
runsync2 "rubyw -x "+currentmacrofilename +" "+$op;
#x=x;#y=y;paste;beginsel;moveto #x,#y;endgroupundo;


