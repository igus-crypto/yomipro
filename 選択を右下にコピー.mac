//選択を右下にコピー

begingroupundo;disabledraw;
if(!selecting){searchdown " ";beginsel;wordleft;left;}
copy2;
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmp.mac";
endgroupundo;enabledraw;endmacro;

