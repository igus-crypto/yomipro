//選択文字で対象ファイルを検索

//標準 :対象ファイルを検索
//ctrl :検索ファイル選択

#fc=0;
if(iskeydown(0x11))#fc=1;
if(getarg(0)=="o")#fc=1;

if(!selecting)endmacro;
$s=getselectedtext();
if(#fc){
  $f=browsefile("","*.txt");
  if(findhidemaru($f)==-1)openfile $f;
  setactivehidemaru findhidemaru($f);
  setsearch $s ,0x35003800;finddown;
  colormarkerallfound;escape;
}
else{
  copy2;
  runsync2 "rubyw -x "+currentmacrofilename;
  execmacro directory + "\\tmp.mac";
}

/*
