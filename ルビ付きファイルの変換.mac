//ルビ付きファイルの変換

disabledraw;
setcompatiblemode 0x0F;

begingroupundo;
replaceall "《/ruby》《ruby》" , "" , regular, nocasesense, nohilight;
#num=25;
while(#num){
replaceall "《ruby》(((?!/ruby).)*?)《rt》(((?!/ruby).)*?)《/rt》(((?!/ruby).)*?)《rt》(((?!/ruby).)*?)《/rt》《/ruby》" , "《ruby》\\1\\3《rt》\\2\\4《/rt》《/ruby》" , regular, nocasesense, nohilight;
#num=#num-1;}
replaceall "《ruby》(((?!/ruby).)*?)《rt》(((?!/ruby).)*?)《/rt》《/ruby》" , "\\1《\\2》" , regular, nocasesense, nohilight;
replaceall "｜\n" , "｜" , regular, nocasesense, nohilight;
replaceall "《/?rb》" , "" , regular, nocasesense, nohilight;


enabledraw;
endgroupundo 1;
