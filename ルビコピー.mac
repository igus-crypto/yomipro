//ルビコピー

//nomal :上から下へコピー
//ctrl  :下から上へコピー
//shift :コメント無し変換無し

begingroupundo;disabledraw;
#fc=0;if(iskeydown(0x11))#fc=1;
#fs=0;if(iskeydown(0x10))#fs=1;

if(selecting){#x=x;#y=y;#ox=selopenx;#oy=selopeny;
  //message str(#oy<#y);
  if(#oy>#y){escape;beginsel;moveto #ox,#oy;}
  else if(#oy==#y && #ox>#x){escape;beginsel;moveto #ox,#oy;}
  selectline 1;wordleft;}
else{golinetop2;beginsel;golineend2;}
#y1=seltoplineno;#y2=selendlineno;cut;
cut;#fg=getclipboardinfo(1);
if(#fc){$opt=" c";}else{$opt=" n";}
if(#fs){$opt=$opt+"s";}
runsync2 "rubyw -x "+currentmacrofilename+$opt;
beginclipboardread;if(#fg){pasterect;}else{paste;}
moveto2 1,#y1;golineend2;
enabledraw;endgroupundo;
endmacro;
