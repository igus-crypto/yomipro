class Array
  def sortq
    ar=self.group_by{|e| e.gsub(/^(!*)([^!].*)/,'\1').size}.
      to_a.sort_by{|e| -e[0].to_i}.transpose[1].to_a.
      map{|e| e.partition{|f| %r|[^ ]*,y|!~f}}
    #print "ar=";p ar
    ar
  end
end


