//クリップボード挿入.mac

begingroupundo;
setmenudelay 50;
mousemenu
"&2 【”+クリップボード】",       // 1
"&7 【’+クリップボード】",       // 2
"&@ 【クリップボード+’】",       // 3
"&s 【/-+クリップボード】",       // 4
"&3 【#+クリップボード】",        // 5
"&/ 【/+クリップボード】",        // 6
"&- 【-+クリップボード】",        // 7
"&e 【イコール変換】",            // 8
"&o 【オプション除去】",          // 9
"&r 【ルビ除去】";                //10

#opt=result;
if(#opt==0){endmacro;}

disabledraw;
if(selecting){cut;}
#fg=getclipboardinfo(1);
#h1=hidemaruhandle(0);
//openfile "/h";paste;
//saveas currentmacrodirectory+"\\tmp99gm.txt";
//#hm=hidemaruhandle(0);setactivehidemaru #h1;
//closehidemaruforced #hm;
runsync2 "rubyw -x "+currentmacrofilename+" "+str(#opt);
openfile "/h "+currentmacrodirectory+"\\tmp99gn.txt";
#hn=hidemaruhandle(0);
if(#fg){gofiletop;beginrect;gofileend;up;golineend;copy2;}
else{selectall;copy2;}
setactivehidemaru #h1;
if(#fg){pasterect;}else{paste;}
closehidemaruforced #hn;

#px=seltopx;#py=seltopy;#dx=selendx;#dy=selendy;
escape;moveto #px,#py;
endgroupundo;enabledraw;endmacro;

