#/
#! ruby
# encoding: utf-8
Encoding.default_external = 'UTF-8'

$stdout=open("tmp99m.txt","w")
$stderr=open("tmp_errm.txt","w")

opt=ARGV[0]

require_relative 'clipboard_compat'
cbd=ClipBoard.new(__ENCODING__)
st=cbd.getText.gsub(/\R/,"\n")

#st=open(__dir__+"/tmp99gm.txt").read.chomp
print "st=";p st
if /10/=~opt
  st=st.gsub(/《[^《》]*》|｜/,"")
elsif /1/=~opt
  st=st.gsub(/^/,"”")
elsif /2/=~opt
  st=st.gsub(/^/,"’")
elsif /3/=~opt
  st=st.gsub(/$/,"’")
elsif /4/=~opt
  st=st.gsub(/^/,"/-")
elsif /5/=~opt
  st=st.gsub(/^/,"#")
elsif /6/=~opt
  st=st.gsub(/^/,"/")
elsif /7/=~opt
  st=st.gsub(/^/,"-")
elsif /8/=~opt
  st=st.gsub(/《[-%=]?/,"《=")
elsif /9/=~opt
  st=st.gsub(/[a-zA-Z0-9,]/,"")
end
print "st=";p st

t=open(__dir__+"/tmp99gn.txt","w")
t.print st

__END__
