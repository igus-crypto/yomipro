//バッチ処理自動

#hwnd= hidemaruhandle(0);
$f1=filename;
runsync2 "ruby -x "+currentmacrofilename+" c "+$f1;
runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\aozora04【ログ削除】.bat";
appendsave currentmacrodirectory+"\\bat\\log\\"+basename;
runsync2 "ruby -x "+currentmacrofilename+" a";
//runsync2 currentmacrodirectory + "\\bat\\aozora01【連続処理全体】.bat";
$r1="ruby -x "+currentmacrodirectory + "\\bat\\青空01【UTF作成】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空02【注釈除去】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空03【直接置換】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空04【ルビ除去１】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空05【ルビ置換１】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空06【ルビ置換２】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空07【ルビ除去２】.bat"+" && ";
$r1=$r1+"ruby -x "+currentmacrodirectory + "\\bat\\青空08【ルビ置換３】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空01【UTF作成】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空02【注釈除去】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空03【直接置換】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空04【ルビ除去１】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空05【ルビ置換１】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空06【ルビ置換２】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空07【ルビ除去２】.bat";
//runsync2 "ruby -x "+currentmacrodirectory + "\\bat\\青空08【ルビ置換３】.bat";
runsync2 "cmd /c "+$r1;
runsync2 "ruby -x "+currentmacrofilename+" b "+$f1;
execmacro currentmacrodirectory + "\\tmp.mac";
closehidemaruforced #hwnd;

//quit;
endmacro;

