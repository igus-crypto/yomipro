    next unless author == aut
    title = row['作品名']
    url   = row['テキストファイルURL']
    next if url.nil? || url.empty?
    filename = File.join(
      author,
      "#{title.gsub(/[\\\/:*?\"<>|]/,'_')}.zip"
    )
    unless FileTest.directory?(aut)
      FileUtils.mkdir_p(aut) if filename
    end
    STDOUT.puts "#{title}"
