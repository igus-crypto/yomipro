//青空文庫まとめ読み.mac

setmenudelay 100;
mousemenu
"&D ダウンロード",     // 1
"&Z ZIP展開",          // 2
"&T 読了時間算出";     // 3

#res=result;
if(#res==0){
  endmacro;
}else if(#res==3){  //【T】 読了時間算出
  execmacro currentmacrodirectory+"\\読了時間算出.mac";
  endmacro;
}else{
  $s=getselectedtext();
}
if(!selecting){
  message "作家名を選択してください";
  endmacro;
}
if(#res==1){        //【D】 ダウンロード
  question $s+"の作品のダウンロードを開始します。よろしいですか？";
  if(result!=0){
    runsync2 "ruby -x "+currentmacrofilename+" d "+$s;
  }
}else if(#res==2){  //【Z】 ZIP展開
  question $s+"フォルダ下のZIPファイルからテキストを作成します。よろしいですか？";
  if(result!=0){
    runsync2 "rubyw -x "+currentmacrofilename+" z "+$s;
    openfile $s+".txt";
  }
}
endmacro;

