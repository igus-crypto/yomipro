      URI.open(url){|src|
        File.binwrite(filename,src.read)
      }
    rescue => e
      warn "失敗: #{title} (#{e})"
    end
  }
elsif opt=="z"
  i=1
  st=""
  Dir.glob("#{aut}/*.zip").sort.each do |zipfile|
    Zip::File.open(zipfile) do |zip|
      zip.each do |entry|
        next unless entry.name =~ /\.txt$/i
        s1 =entry.get_input_stream.read
        st << "\n☆彡#{i}☆彡"
        st << s1.force_encoding("CP932").encode("UTF-8")
        i+=1
      end
    end
  end
  st=st.gsub("\r","").
    gsub(%r|^-{20,}.*?^-{20,}$|m,"").
    gsub(%r|\n{2,}|,"\n\n").
    gsub(%r|^☆彡(\d+)☆彡(.*)|){"【第#{$1.tr('0-9','０-９')}話】　【#{$2}】"}
  File.write("#{aut}.txt",st)
end

__END__
