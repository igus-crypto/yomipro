//    endmacro;
  if(#m>=4){
    if(#n[2]==2){#n[6]=2;}
    else if(#n[3]==2){#n[6]=2;}
    else if(#n[4]==2){#n[6]=2;}
    else if(#n[5]==2){#n[6]=2;}
    else if(#n[1]==2){#n[6]=2;}
    else if(#n[7]==2){#n[7]=3;}
  }else if(#m==3){
    if(#n[2]==2){#n[5]=2;}
    else if(#n[3]==2){#n[6]=2;}
    else if(#n[4]==2){#n[6]=2;}
    else if(#n[5]==2){#n[6]=2;}
    else if(#n[1]==2){#n[6]=2;}
    else if(#n[7]==2){#n[7]=3;}
  }else if(#m==2){
    if(#n[2]==2){#n[4]=2;}
    else if(#n[3]==2){#n[5]=2;}
    else if(#n[4]==2){#n[6]=2;}
    else if(#n[5]==2){#n[6]=2;}
    else if(#n[1]==2){#n[6]=2;}
    else if(#n[7]==2){#n[7]=3;}
  }else if(#m==1){
    if(#n[2]==2){#n[3]=2;}
    else if(#n[3]==2){#n[4]=2;}
    else if(#n[4]==2){#n[5]=2;}
    else if(#n[5]==2){#n[6]=2;}
    else if(#n[1]==2){#n[6]=2;}
    else if(#n[7]==2){#n[7]=3;}
  }
  //message str(#n[1])+"/"+str(#n[2])+"/"+str(#n[3])+"/"+str(#n[4])+"/"+
  //  str(#n[5])+"/"+str(#n[6])+"/"+str(#n[7])+"/"+str(#n[8])+"/"+str(#n[9])+"\n"+str(#m);
  //endmacro;
  if(#n[8]>1 || #n[9]>1){
    gofileend
  }else if(#n[7]>2){
    searchdown ",[~=]",regular;golinetop2;left;
  }else if(#n[7]==2){
    //selectline 1;#x=x;#y=y;
    //replaceallfast ",.*[ぁ-ん]","",regular,inselect2;
    //#r=result;//undo;message str(#r);
    //if(#r==0){
    //  moveto 0,#y-1;beginsel;
    //  searchdown ",.*[ぁ-ん]",regular;golinetop2;left;
    //}else{
    //  undo;beginsel;
    //  searchdown ",[~=]",regular;golinetop2;left;
    //}
    beginsel;
    searchdown ",[~=]",regular;golinetop2;left;
  }else if(#n[6]>1){
    searchdown ",[#~=]",regular;golinetop2;left;
  }else if(#n[5]>1){
    searchdown ",[’#~=]",regular;golinetop2;left;
  }else if(#n[4]>1){
    //searchdown ",[’#~=/]",regular;golinetop2;left;
    searchdown ",[#]",regular;golinetop2;left;
  }else if(#n[3]>1){
    searchdown ",[-’#~=/]",regular;golinetop2;left;
  }else if(#n[2]>1){
    searchdown ",[-%’#~=/]",regular;golinetop2;left;
  }else{
    searchdown ",[-+%’#~=/]",regular;golinetop2;left;
  }
}
if(y==selopeny){copy;}
else{selectline 1;copy;}
