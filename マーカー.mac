//マーカー

runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmp.mac";
endmacro;

/*
#/
#! ruby
# encoding: utf-8
Encoding.default_external = 'UTF-8'

$stdout=open("tmp99m.txt","w")
$stderr=open("tmp_errm.txt","w")


st=open(__dir__+"/config.ini").read
