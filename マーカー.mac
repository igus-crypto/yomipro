#.gsub(%r|color_num=color_\d+|,"color_num=color_1")

n=ar.grep(/color_num=color_(\d+)/)[0].gsub("color_num=color_","").to_i
print "n=";p n
col=ar.grep(%r|color_#{n}=|)[0]
print "col=";p col
col=col.to_s.gsub(%r|color_#{n}=|,"")
col="0x"+col
mac=File.expand_path("tmp.mac")
print "mac=";p mac
macro=open(mac,"w")
macro.print("\uFEFF")
macro.puts %Q|colormarker 0x000000,#{col},-1,0,0;escape;|
macro.puts %Q|runsync2 "rubyw -x "+currentmacrofilename;|
macro.puts %Q|endmacro;|

n=(n.to_i+1)%16
n+=1 if n==0
st=st.gsub(/color_num=color_(\d+)/,"color_num=color_#{n}")
File.write(__dir__+"/config.ini",st)



__END__
