//自動送り.mac

setcompatiblemode 0x02000000;

//message str(code);endmacro;

//shift:次の秀丸
//alt  :下へ

#fs=0;#fa=0;
if(iskeydown(0x12))#fa=1;
if(iskeydown(0x10))#fs=1;

if(#fa){
  //message str(y)+"/"+str(linecount);
  while(y+1<linecount){
    #sty=screentopy;
    if(iskeydown(28)){endmacro;}                     //無変換
    else if(iskeydown(0x10)){endmacro;}              // shift
    else if(iskeydown(0x11) && iskeydown(0x28)){     // ctrl+下
      disabledraw;enabledraw linenotoy(0,y);
      if(#sty==screentopy){
        moveto #x0,#y0+windowheight/4;sleep(50);}}
    else if(iskeydown(0x26)){up;sleep(50);}           // 上
    else if(iskeydown(0x28)){down;sleep(50);}         // 下
    else if(iskeydown(0x27)){right;sleep(50);}        // 右
    else if(iskeydown(0x25)){left;sleep(50);}         // 左
    else if(iskeydown(32)){sleep(50);}                // space
    else{
      if(iskeydown('N')){#n=5;}else{#n=50;}
      #j=0;
      while(#j<7){
      if(iskeydown(0x10))endmacro; //shift
      if(iskeydown(0x11) && iskeydown(0x28)){         // ctrl+下
        disabledraw;enabledraw linenotoy(0,y);
        #sty=screentopy;}
      sleep(#n);escape;#j=#j+1;
      }
    down;
    //config "xUnderLine:1";
    //selectline 1;
    }
    if(#sty!=screentopy){
      disabledraw;
      enabledraw y - windowheight / 3;
    }
  }
  endmacro;
}

if(#fs){
  #i=1;
  while(basename[#i]!=""){
    if(leftstr(basename[#i],3)=="tmp" || rightstr(basename[#i],4)!=".txt"){
      #i=#i+1;
    }else{
      //message basename[#i];
      setactivehidemaru #i;escape;searchup "^|[。　！？]",regular;
      break;
    }
  }
}
escape;#x=x;#y=y;
disabledraw;
goscreentop;#y2=y;
goscreenend;#y3=y;
//#n=(#y3-#y2)*9/10;
#n=(#y3-#y2)*7/10;
enabledraw;
//message str(#n);
//endmacro;
moveto #x,#y;
beginsel;
//message str(code);endmacro;
if(imestate)imeswitch;
while(1){
  if     (iskeydown('Q')){while(iskeydown('Q')){sleep 10;}sleep 10;escape;endmacro;}
  else if(iskeydown('B')){while(iskeydown('B')){sleep 10;}sleep 10;escape;endmacro;}
  else if(code==33182){right;if(code==33090)right;sleep 56;} //◇
  else if(code==32){right;} //半角スペース
  else if(code==33090){ //。
    right;
    if ((iskeydown('R')) || (iskeydown('N'))){
      sleep 50;
    }else{
      sleep 500;
    }
    #x=x;#y=y;
    colormarker 0x000000, 0x7AAFFF, 11, 1;
    escape;disabledraw;goscreentop;#y2=y;
    moveto #x,#y;enabledraw;
    //message "y="+str(#y)+"\ny2="+str(#y2);
    //message str(#y)+"**"+str(#y2)+"**"+str(#y-#y2);
    if(#y-#y2>=#n){halfnextpage;sleep 500;}
    moveto #x,#y;beginsel;
    if(code==13){right;
      colormarker 0x000000, 0x7AAFFF, 11, 1;
      escape;beginsel;}}
  else if(code==33097 || code==33096){ //！　,？　,！」,？」
    right;sleep 56;
    if(code==33088 || 33142){ //　,」
    right;
    if ((iskeydown('R')) || (iskeydown('N'))){
      sleep 50;
    }else{
      sleep 500;
    }
    #x=x;#y=y;
    colormarker 0x000000, 0x7AAFFF, 11, 1;
    escape;disabledraw;goscreentop;#y2=y;
    moveto #x,#y;enabledraw;
    //message str(#y)+"**"+str(#y2)+"**"+str(#y-#y2);
    if(#y-#y2>=#n){halfnextpage;sleep 500;}
    moveto #x,#y;beginsel;
    if(code==13){right;
      colormarker 0x000000, 0x7AAFFF, 11, 1;
      escape;beginsel;}}}
  else if(code==13||code==58){ //行末=>13 :=>58
    right;sleep 500;#x=x;#y=y;
    colormarker 0x000000, 0x7AAFFF, 11, 1;
    escape;disabledraw;goscreentop;#y2=y;
    moveto #x,#y;enabledraw;
    if(#y-#y2>=#n){halfnextpage;sleep 56;}
    moveto #x,#y;beginsel;}
  else if(iskeydown(' ')){sleep 10;}
  else if(iskeydown('R')){right;sleep 10;}
  else if(iskeydown('N')){right;sleep 10;}
  else{#x=x;#y=y;right;sleep 56;if(#x==x && #y==y){endmacro;}}
}
endmacro;

