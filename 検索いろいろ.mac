//検索いろいろ

$d=directory;

#shi=0;#alt=0;
if(iskeydown(0x10)){#shi=1;}
if(iskeydown(0x12)){#alt=1;}

if(#shi==1 || #alt==1){ //選択
  begingroupundo;
  setmenudelay 300;
  mousemenu
  "&J コメント選択",            // 1
  "&A 全て",                    // 2
  "&F 前方",                    // 3
  "&B 後方",                    // 4
  "&K 漢字",                    // 5
  "&P pオプション",             // 6
  "&@ ルビチェック１",          // 7
  "&[ ルビチェック２",          // 8
  "&. =>",                      // 9
  "&L 一文字";                  //10
  
  //message str(result);
  #r=result;
  if(#r==0){endmacro;
  }else if(#r==1){  //【J】 コメント選択
    golineend2;beginsel;searchup "=>";right;right;
  }else if(#r==2){  //【A】 全て
    selectall;
  }else if(#r==3){  //【F】 前方
    escape;beginsel;gofiletop;
  }else if(#r==4){  //【B】 後方
    escape;beginsel;gofileend;
  }else if(#r==5){  //【K】 漢字
    escape;#i=3;
    while(#i>0){
      golineend;beginsel;searchup "^|=",regular;
      searchdown "[\\p{Han}]+",regular,inselect2,nohilight;
      if(result){
        if(!imestate)imeswitch;
        #tx=foundtopx;#ty=foundtopy;#ex=foundendx;#ey=foundendy;
        moveto #tx,#ty;beginsel;moveto #ex,#ey;
        //message getselectedtext();
        endmacro;
      }else{
        down;
        #i=#i-1;
      }
    }
  }else if(#r==6){  //【P】 pオプション
    gofiletop;searchdown ",p",nohilight;golinetop2;beginsel;
    searchdown ",[ぁ-ん]",regular;
    if(result){
      golinetop2;up;
    }else{
      gofileend;
    }
  }else if(#r==7){  //【@】 ルビチェック１
    gofiletop;searchdown "[\\p{Han}][\\p{Han}]+,[+]",nohilight,regular;
    if(result){
      golinetop2;beginsel;
      searchdown "^!*[\\p{Han}],[+]",nohilight,regular;golinetop2;up;golineend2;
    }else{
      gofiletop;searchdown "^[!]?[\\p{Han}][\\p{Han}]+,[ぁ-ん]+,[+]",nohilight,regular;
      golinetop2;beginsel;
      searchdown "^[!]?[\\p{Han}],[ぁ-ん]+,[+]",nohilight,regular;golinetop2;up;golineend2;
    }
  }else if(#r==8){  //【[】 ルビチェック２
    gofiletop;searchdown "^[!]*[\\p{Han}],[+]",nohilight,regular;
    if(result){
      golinetop2;beginsel;
      searchdown ",[-%ァ-ヴーぁ-ん]",nohilight,regular;golinetop2;up;golineend2;
    }else{
      gofiletop;searchdown "^[!]?[\\p{Han}],[ぁ-ん]+,[+]",nohilight,regular;
      golinetop2;beginsel;
      searchdown ",[ぁ-ん]+$",nohilight,regular;golinetop2;up;golineend2;
    }
  }else if(#r==9){  //【.】 =>
      disabledraw;
      gofiletop;searchdown "=>",nohilight,regular;
      golinetop2;#x=x;#y=y;gofileend;
      enabledraw;moveto #x,#y;
  }else if(#r==10){  //【L】 一文字
    if(code==13){beginsel;left;}else{beginsel;right;}
  }
  endmacro;
}

begingroupundo;
setmenudelay 300;
mousemenu
"&F ファイル内",             // 1
"&N 次の秀丸",               // 2
"&Y 龠を検索",               // 3
"&T 対象ファイル",           // 4
"&O ファイルを開く",         // 5
"&J タグジャンプサーチ",     // 6
"&H 漢字をマーク",           // 7
"&M 要注意漢字をマーク",     // 8
"&R ルビの読み",             // 9
"&, ルビ《",                 //10
"&A ルビリスト",             //11
"&8 ８１行目",               //12
"&9 重複ルビ",               //13
"&0 踊り字",                 //14
"&L 行数指示",               //15
"&G Googleで検索",           //16
"&K Kindleを検索";           //17

#r=result;
if(selecting){
  $s=getselectedtext();
}else{
  $s=getclipboard();
}

if(#r==0){endmacro;
}else if(#r==1){  //【F】 ファイル内
  if(!selecting){searchdialog $s;
  }else{
    escape;
    searchdown $s,hilight;finddown;
    //searchdown $s,hilight;
  }
}else if(#r==2){  //【N】 次の秀丸
  setactivehidemaru 1;
  escape;
  searchdown $s,hilight;
  if(!result)searchdialog $s;
  #tx=foundtopx;#ty=foundtopy;#ex=foundendx;#ey=foundendy;
  escape;moveto #tx,#ty;beginsel;moveto #ex,#ey;
}else if(#r==3){  //【Y】 龠を検索
  searchdown "龠",hilight;
}else if(#r==4){  //【T】 対象ファイル
  execmacro currentmacrodirectory+"\\\\選択文字で対象ファイルを検索.mac";
}else if(#r==5){  //【O】 対象ファイル
  execmacro currentmacrodirectory+"\\\\選択文字で対象ファイルを検索.mac","o";
}else if(#r==6){  //【J】 タグジャンプサーチ
  execmacro currentmacrodirectory+"\\\\タグジャンプサーチ.mac";
}else if(#r==7){  //【H】 漢字をマーク
  setcompatiblemode 0x0F;
  setsearch "[\\p{han}]" , 0x4003812;
  //hilightfound 1;
  //setcompatiblemode 0x20000;
  //setsearch "[\\p{Han}]" , 0x4003819;
  //colormarkerallfound 0, 0xB2B2F5, 0, 0;
  colormarkerallfound 0x000000, 0xFF97B1, 11, 1;
}else if(#r==8){  //【M】 要注意漢字をマーク
  disabledraw;#x=x;#y=y;selectall;copy
  runsync2 "rubyw "+currentmacrodirectory+"\\grep6.rbw m "+filename;
  execmacro directory + "\\tmp.mac";
  moveto #x,#y;enabledraw;
}else if(#r==9){  //【R】 ルビの読み
  gofiletop;searchdown "^[\\p{Han}]+,[ぁ-ん]+$",nohilight,regular;golinetop2;beginsel;
  searchdown "^!|[^,]*,[^,]*,",regular;golinetop2;
}else if(#r==10){  //【,】 ルビ《
  gofiletop;searchdown "《",nohilight;golinetop2;
}else if(#r==11){  //【A】 ルビリスト
  setactivehidemaru 1;
  searchup $s,loop;colormarkerallfound 0, 0xB2B2F5, 0, 0;
  golinetop2;
}else if(#r==12){  //【8】 ８１行目
  unfoldall;escape;moveto 0,80;
}else if(#r==13){  //【9】 重複ルビ
  execmacro currentmacrodirectory+"\\\\重複ルビ検索.mac";
}else if(#r==14){  //【0】 踊り字
  execmacro currentmacrodirectory+"\\\\踊り字検索.mac";
}else if(#r==15){  //【/】 行数指示
  execmacro currentmacrodirectory+"\\\\検索の行数指示.mac";
}else if(#r==16){  //【G】 Googleで検索
  if(selecting){
    $sel=gettext(seltopx,seltopy,selendx,selendy,1);
    run "cmd /c start chrome --incognito http://www.google.co.jp/search?q="+$sel+">nul";}
}else if(#r==17){  //【K】 Kindleを検索
  execmacro currentmacrodirectory+"\\\\kindle検索.mac";
}
endmacro;
