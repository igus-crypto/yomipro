//タグジャンプサーチ

disabledraw;
if(selecting){copy2;}else{beginsel;right;copy2;left;}
#tx=seltopx;#ty=seltopy;#ex=selendx;#ey=selendy;
golinetop2;searchdown ":";searchdown "[0-9]+",regular;
$n=gettext(foundtopx,foundtopy,foundendx,foundendy);
moveto #tx,#ty;beginsel;moveto #ex,#ey;
enabledraw;
tagjump;
#r=result;
runsync2 "rubyw -x "+currentmacrofilename+" "+str(#r)+" "+$n;
execmacro directory + "\\tmp.mac";
endmacro;

