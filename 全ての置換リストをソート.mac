/*
#/
#! ruby
# encoding: utf-8
# sort6
# ルビソート（全て）
Encoding.default_external = 'UTF-8'


#デバッグ用
$stdout=open("tmp_s99.txt","w")
$stderr=open("tmp_serr.txt","w")

require 'win32ole'

class String
  def bsize
    self.to_s.tr("—","-").split("").map{|e| e.bytesize==1 ? 1 : 2}.sum
    #"—"が実は３バイトという罠回避 "-"は１バイト
  end
end
class Array
  def sortq
    ar=self.group_by{|e| e.gsub(/^(!*)([^!].*)/,'\1').size}.
      to_a.sort_by{|e| -e[0].to_i}.transpose[1].to_a.
      map{|e| e.partition{|f| %r|[^ ]*,y|!~f}}
    #print "ar=";p ar
    ar
  end
  def p10
    sf=self.grep_v([])
    if sf[0].is_a?(Array)
      sf.map{|e| e.p10}
    else
      sf.group_by{|e| e.match(/^(.*?),/).to_s.bsize}.to_a.
        sort_by{|e| -e[0].to_i}.transpose[1].to_a.map{|e| e.sort}.flatten.
        each_slice(10).to_a.map{|e| e.join("\n")}.join("\n\n")
    end
  end
  def rep
    sf=self.grep_v([])
    if sf[0].is_a?(Array)
      sf.map{|e| e.rep}
    else
      arr=self
      rep=arr.grep(/!*([^ ,]+),([^ ,]+),([^ ,]+)/)
      arr=arr-rep
      [arr,rep]
    end
  end
  def list_sort
    sf=self.grep_v([])
    if sf[0].is_a?(Array)
      sf.map{|e| e.list_sort}
    else
      arr,st=self,""
      sur=arr.grep(/^[\/]/).sort_by{|e| e.match(/^!+[^,]+/).to_s.bsize}.reverse;arr=arr-sur
      exc=arr.grep(/^[\!]/).sort_by{|e| e.match(/^!+[^,]+/).to_s.bsize}.reverse;arr=arr-exc
      hir=arr.grep(/^[^, ]+,[ぁ-んー]+$/);arr=arr-hir
      pur=arr.grep(/[+]/);arr=arr-pur
      col=arr.grep(/[:]/);arr=arr-col
      quo=arr.grep(/^[^, ]+,[’]/);arr=arr-quo
      bou=arr.grep(/ヽ/) ;arr=arr-bou
      ex2=arr.grep(/[!]/);arr=arr-ex2
      per=arr.grep(/[%]/);arr=arr-per
      shr=arr.grep(/[#]/);arr=arr-shr
      eql=arr.grep(/[=]/);arr=arr-eql
      mai=arr.grep(/[-]/);arr=arr-mai
      sur=arr.grep(/^[\/]/);arr=arr-sur
      hik=arr.grep(/^[^\p{Han}, ]+,/);arr=arr-hik
      kan=arr.grep(/^[^, ]+,[^ ]*[\p{Han}]/);arr=arr-kan
      kat=arr.grep(/^[^, ]+,[^ ]*[ァ-ヴー]/);arr=arr-kat
      [sur,exc,hir,pur,col,quo,arr,bou,per,ex2,kat,mai,sur,hik,kan,shr,eql].rep
    end
  end
end


Dir.glob(__dir__+%Q|/置換リスト/置換リスト*.txt|){|ofile|
  st="\uFEFF"
  p File.basename(ofile)
  arr=open(ofile).read.gsub(/\xEF\xBB\xBF|\xEF\xBF\xBE/,"").split(/\R/).
    grep_v(/^―*$|^最終更新日：/).map{|e| e.chomp}
  #arr=open(ofile).readlines.grep_v(/^―*$|^最終更新日：/).map{|e| e.chomp}
  
  upd="最終更新日："+Time.new.strftime("%Y.%m.%d")+"\n\n"
  sep="―"*20+"\n"
  
  arr=arr.uniq
  print "arr=";p arr
  
  if /【ルビチェック】/=~ofile
    #重複要素のチェック
    jyu=arr.map{|e| e.gsub(/^!+([^,]+),[+-]?([^, ]+)/,'\1,\2')}.
      group_by{|e| e}.select{|k,v| v.size>1}.map(&:first)
    jyu.map{|e| print "e=";p e}
    jyu.map{|e| f=e.split(",");arr=arr.grep_v(/^[!]*#{f[0]},[+-]?#{f[1]}/)}
    jyu=jyu.map{|e| f=e.split(",");"!!#{f[0]},+#{f[1]}"}
    
    #ルビ付き分離
    rbt=arr.grep(/《.*》/);arr=arr-rbt
    p rbt=rbt.partition{|e| /=>$/=~e}
    #!分離
    p arr.grep(/^!/).group_by{|e| p e.gsub(%r|^(!+)[^!].*|,'\1').size}.to_a.sort_by{|e| -e[0].to_i}
    ext=arr.grep(/^!/).group_by{|e| e.gsub(%r|^(!+)[^!].*|,'\1').size}.
      to_a.sort_by{|e| -e[0].to_i}.map{|e| e[1]}
    arr=arr-ext.flatten
    rep=arr.grep(/!*([^ ,]+),([^ ,]+),([^ ,]+)/)
    arr=arr-rep
    print "ext=";p ext
    st+=upd+[jyu,ext,arr,rep,rbt].list_sort.p10.join("\n\n")+"\n"
    File.write(ofile,st)
    #cbd.setText(st)
    #spawn(%Q|rubyw #{__dir__}/sort3.rbw |)
    next
  end
  
  #重複要素
  #ar2=arr.select{|e| arr.count(e) > 1}.uniq
  #jfk= (ar2==[] ? "" : ar2.map{|e| "!"+e}.join("\n")+"\n\n")
  #arr=arr-ar2
  
  #コメント１分離
  ar2=arr.grep(%r|^#|)
  com1= (ar2==[] ? "" : ar2.join("\n")+"\n\n")
  arr=arr.grep_v(%r|^#|)
  
  arr=arr.sort_by{|e|
    g=(/^([^ ]*?),/=~e ? $1 : e.chomp)
    g.bsize}.reverse
  
  #b オプションを最初
  ar2=arr.grep(/[^, ]*,b/).sort
  bop= (ar2==[] ? "" : ar2.join("\n")+"\n\n")
  arr=arr.grep_v(/[^, ]*,b/)
  
  #s オプションを次に
  #ar2=arr.grep(/[^, ]*,s/).sort
  ar2=arr.grep(/[^, ]*,s/).group_by{|e| e.match(/^(.*?),/).to_s.bsize}.
    to_a.sort_by{|e| -e[0].to_i}.transpose[1].to_a.map{|e| e.sort}.flatten
  sop= (ar2==[] ? "" : ar2.join("\n")+"\n\n")
  arr=arr.grep_v(/[^, ]*,s/)
  
  #10個ずつに分けて出力
  #コメント２分離
  #ar2=arr.grep(%r|^/|).sort.each_slice(10).to_a.map{|e| e.join("\n")}
  ar2=arr.grep(%r|^/|).group_by{|e| e.match(/^(.*?),/).to_s.bsize}.to_a.sort_by{|e| -e[0].to_i}.
    transpose[1].to_a.map{|e| e.sort}.flatten.each_slice(10).to_a.map{|e| e.join("\n")}
  com2= (ar2==[] ? "" : ar2.join("\n\n")+"\n\n")
  arr=arr.grep_v(%r|^/|)
  
  #要注意分離
  #ar2=arr.grep(/^!+/).sort.sort_by{|e| e.match(/^!+/).to_s.bsize}.reverse.
  ar2=arr.grep(/^!+/).sort_by{|e| e.match(/^!+[^,]+/).to_s.bsize}.reverse.
    each_slice(10).to_a.map{|e| e.join("\n")}
  ex=(ar2==[] ? "" : ar2.join("\n\n")+"\n\n")
  arr=arr.grep_v(/^!/)
  
  #親文字のみ分離
  ar2=arr.grep_v(/,/)
  grp=ar2.group_by{|e| e.chomp.bsize}.to_a.transpose[1].to_a.map{|e| e.sort.reverse}.
    map{|e| e.each_slice(10).to_a.map{|f| f.join("\n")}.join("\n\n")}
  #oya=(ar2==[] ? "" : grp.map{|e| e.join("\n")}.join("\n")+"\n\n")
  oya=(ar2==[] ? "" : grp.join("\n")+"\n\n")
  arr=arr.grep(/,/)
  
  #pとrのオプションなし
  ar2=arr.grep_v(%r|[^, ]*,[rpy]|)
  ar3=ar2.group_by{|e| e.match(/^(.*?),/).to_s.bsize}.to_a.sort_by{|e| -e[0].to_i}.
    transpose[1].to_a.map{|e| e.sort.reverse}
  wor=(ar2==[] ? "" : ar3.flatten.each_slice(10).to_a.map{|f| f.join("\n")}.join("\n\n")+"\n\n")
  ar4=arr.grep(%r|[^ ]*,[rp]|)
  ar5=arr.grep(%r|[^ ]*,y|)
  
  #pとrのオプション付き
  ar4=ar4.group_by{|e| e.match(/[^, ]*,([rp][0-9.]*)/)[1]}.to_a.
    sort_by{|e| e[0]}.sort_by{|e| e[0].scan(/[0-9.]+/)}.transpose[1].
    to_a.map{|e| e.group_by{|v| 1.0/(v.gsub(/,.*$/,"").bsize)}.to_a.
    transpose[1].to_a.map{|v| v.sort.reverse}}
  reg=(ar4==[] ? "" : sep+
    ar4.map{|e| e.flatten.each_slice(10).to_a.map{|f| f.join("\n")}.
      join("\n\n")}.join("\n\n"+sep)+"\n\n")
  arr=arr.grep(%r|[^ ]*,y|)
  
  #yオプション付き
  ar5=ar5.group_by{|e| e.match(/[^, ]*,(y[0-9.]*)/)[1]}.to_a.
    sort_by{|e| e[0]}.sort_by{|e| e[0].scan(/[0-9.]+/)}.transpose[1].
    to_a.map{|e| e.group_by{|v| 1.0/(v.gsub(/,.*$/,"").bsize)}.to_a.
    transpose[1].to_a.map{|v| v.sort.reverse}}
  yop=(ar5==[] ? "" : sep+
    ar5.map{|e| e.flatten.each_slice(10).to_a.map{|f| f.join("\n")}.
      join("\n\n")}.join("\n\n"+sep)+"\n\n")
  
  st+=upd+com1+bop+sop+com2+ex+oya+wor+reg+yop
  
  p st
  #cbd.setText(st)
  File.write(ofile,st)
}

wsh = WIN32OLE.new('WScript.Shell')
wsh.Popup("置換リストファイルをソートしました",1)

__END__
*/
