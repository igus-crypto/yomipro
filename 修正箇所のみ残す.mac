//修正箇所のみ残す

if(updated==0);endmacro;
disabledraw;begingroupundo;gofiletop;#i=1;$s="txt\n"+filename+"\n";
while(1){
  #y1=y;#i=#i+1;
  if(!lineupdated){beginsel;golineend2;delete;}else{$s=$s+str(#i-2)+",";}
  movetolineno 1,#i;
  if(y==#y1)break;
  }
replaceallfast "^\n","",regular:gofiletop;
enabledraw;endgroupundo;
#h1=hidemaruhandle(0);
openfile "/h";insert $s;
saveas "tmp_s.txt",utf8,bom;
#h2=hidemaruhandle(0);
setactivehidemaru #h1;
closehidemaruforced #h2;

runsync2 "rubyw -x "+currentmacrofilename;
endmacro;

