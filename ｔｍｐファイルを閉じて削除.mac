//ｔｍｐファイルを閉じて削除

//標準          :ひとつ下のウィンドウを基準
//ctrl          :アクティブなウィンドウを基準
//ctrl+shft     :ウィンドウをひとつ残して他は閉じる
//ctrl+shft+alt :全終了

//シフトキーとコントロールキーの状態確認
#fs=0;#fc=0;#fa=0;
if(iskeydown(0x10))#fs=1;
if(iskeydown(0x11))#fc=1;
if(iskeydown(0x12))#fa=1;

//オプション確認
$op=getarg(0);
if($op=="2"){#fs=1;#fc=1;}

#c= hidemarucount;#i=0;#j=0;#k=0;#n=0;

if(leftstr(basename[0],3)!="tmp")$fa=filename[0];
while(#i<#c){
  if(leftstr(basename[#i],3)=="tmp"){
    $fs[#j]=filename[#i];
    //message "fs="+$fs[#j];
    #j=#j+1;
  }else{
    //message filename[#i];
    //if($fa=="")$fa=filename[#i];
    $fa[#n]=filename[#i];
    #n=#n+1;
  }
  #i=#i+1;
}
//message $fa[0];
if($fa[0]==""){
  #k=1;
}else{
  setactivehidemaru findhidemaru($fa[0]);
}

while(#k<#j){
  closehidemaruforced findhidemaru($fs[#k]);
  #k=#k+1;
}
question "tmpファイルを削除しますか？";
if(result==yes){runsync2 "rubyw "+currentmacrodirectory+"\\\\del_tmp.rbw";}
//if(result==yes){runsync2 "rubyw "+currentmacrofilename;}
if(#fs && #fc){
  #k=1;
  //message "k="+str(#k)+",n="+str(#n);
  while(#k<#n){
    closehidemaruforced findhidemaru($fa[#k]);
    #k=#k+1;
  }
}
if(#fa*#fc*#fs==1)exitall;
endmacro;


