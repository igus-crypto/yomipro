//上へ移動.mac

#alt=0;
if(iskeydown(0x12)){#alt=1;}

disabledraw;begingroupundo;
if(#alt==1){
  selectline 1;cut;
  searchup "^$",regular;
  if(!result){gofiletop;insert "\n";up;paste;}else{down;paste;}
}else{
  #x=x;#y=y;disabledraw;begingroupundo;
  selectline 1;
  #tx=seltopx;#ty=seltopy;#ex=selendx;#ey=selendy;
  //message str(#ty)+"/"+str(#ey);endmacro;
  selectall;copy;
  runsync2 "rubyw -x "+currentmacrofilename+" "+str(#ty)+" "+str(#ey-1);
  moveto #x,#y;
  execmacro directory + "\\tmp.mac";
}
enabledraw;endgroupundo;
endmacro;

