//選択をtmp.txtの末尾にコピー

//標準:数字無し
//ctl :memo.txtを開いていればmemo.txtの末尾へ
//shi :現在のファイルの末尾

$o="";
if(iskeydown(0x10)){$o=$o+"s";}
if(iskeydown(0x11)){$o=$o+"c";}
if(iskeydown(0x12)){$o=$o+"a";}

//if($o=="s"){
//  if(!selecting)endmacro;
//  copy;gofileend;insert "\n";paste;gofileend;insert "\n";endmacro;
//}

//if(multiselecting && strstr($o,"s")<0){
//  //message getselectedtext();endmacro;
//  $t=gettext(seltopx[0],seltopy[0],selendx[0],selendy[0],1)+","+
//    gettext(seltopx[1],seltopy[1],selendx[1],selendy[1],1);
//  escape;gofileend;insert $t+"\n";up;endmacro;
if(selecting){
  if(strstr($o,"s")>=0){disabledraw;
    #tx=seltopx;#ty=seltopy;#ex=selendx;#ey=selendy;
    #ix=seltopy;#iy=seltopy;#f=0;
    escape;
    $c=getcolormarker(0x0002);$s="";
    //message $c;endmacro;
    moveto #tx,#ty;
    while(#iy<=#ey){
      if(code==eof){break;}
      moveto #tx,#iy;
      while(x<=#ex){
        $c=getcolormarker(0x0002,findmarker);
        //message str(x)+":"+str(y);
        if($c!="" && #f==0){beginsel;#f=1;}
        else if($c=="" && #f==1){$s=$s+getselectedtext()+"\n";escape;#f=0;}
        else if(code==13 && #f==1){$s=$s+getselectedtext()+"\n";escape;#f=0;break;}
        else if(code==13){break;}
        //sleep 100;
        #ix=x;right;
        if(x==#ix){#f=2;break;}
      }
      if(#f==2){break;}
      #iy=#iy+1;
    }
    //message $s;
    enabledraw;
    openfile "/h";insert $s;saveas "tmp_t.txt";selectall;copy;
    #hwnd=hidemaruhandle(0);
    setactivehidemaru 1;closehidemaru #hwnd;
    moveto #tx,#ty;
    runsync2 "rubyw -x "+currentmacrofilename+" "+$o;
  }else{
    copy;
    runsync2 "rubyw -x "+currentmacrofilename+" "+$o;
  }
  $t="tmp.txt";
  //if (findhidemaru("memo.txt") && strstr($o,"c")>=0)$t="memo.txt";
  if (findhidemaru("memo.txt") && $o=="c")$t="memo.txt";
  //message str(findhidemaru("memo.txt"));
  //message str(strstr($o,"c"));
  //message $o;
  if(basename==$t){gofileend;paste;up;endmacro;}
  else if( findhidemaru($t)==-1){openfile $t;insert "\n";save;}
  setactivehidemaru findhidemaru($t);
  escape;gofileend;paste;up;
  if($o!="s"){setactivehidemaru 1,-1;}
}
endmacro;


