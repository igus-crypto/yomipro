$stdout=open("tmp99.txt","w")

filename=ARGV[0].encode(Encoding::UTF_8).gsub("\\","/")
p filename

cbd=ClipBoard.new(__ENCODING__)
st=cbd.getText.gsub(/\r\n/,"\n")

st2=st.gsub(/(.?)((?:(?:[\p{Han}]+|｜[^《》:]+|.)《[^》:]*》){2,})/){
  s1,s2=$1,$2
  print "s12=";p [s1,s2]
