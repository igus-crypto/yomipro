  sr=s2.scan(/《([^》]*)》/).join
  so="｜"+so if (/[^\p{Han}]/=~so or /[\p{Han}]/=~s1)
  "#{s1}#{so}《#{sr}》"}
st2=st2.gsub(/《[^《》]*》/){|s| s.gsub(/ /,"")}

File.write("tmp_r.txt",st2+"\n")
