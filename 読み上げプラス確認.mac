//読み上げプラス確認

#x0=x;#y0=y;
escape;moveto 0,y;beginsel;gofileend;copy;moveto 0,#y0;
runsync2 "rubyw -x "+currentmacrofilename;
execmacro directory + "\\tmpp.mac";
execmacro currentmacrodirectory+"\\\\grepスタンダード.mac";
endmacro;

